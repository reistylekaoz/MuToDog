/* ---- Obsidiana e prata, rodada 11: Horário dos eventos com a moldura, a placa do título e os botões do Meshy (base.rcss) ---- */
#panel { background-color: transparent; decorator: ninepatch(ob-moldura, ob-moldura-in, 2); border-width: 0; }
#title { left: 128dp; top: 3dp; width: 180dp; height: 18dp; line-height: 18dp; decorator: ninepatch(ob-placa, ob-placa-in, 2); }
#prev, #next, #close { background-color: transparent; decorator: ninepatch(ob-botao, ob-botao-in, 2); border-width: 0; }
#prev:hover, #next:hover, #close:hover { decorator: ninepatch(ob-botao-sob, ob-botao-sob-in, 2); }
#prev.disabled, #prev.disabled:hover, #next.disabled, #next.disabled:hover { decorator: ninepatch(ob-botao-off, ob-botao-off-in, 2); }
/* as cores da contagem e do cadeado ficam as do Godot (amarelo pra abrir, verde aberto, dourado entra) */
#clock { color: #e8c96a; }
.count { color: #ffd25a; }
.watch { border-color: #ffd25a; }
.hand { background-color: #ffd25a; }
.lock.enter .shackle { border-color: #e6b950; }
.lock.enter .body { background-color: #e6b950; }
.card.open .count { color: #78eb8c; }
.card.open .watch { border-color: #78eb8c; }
.card.open .hand { background-color: #78eb8c; }
