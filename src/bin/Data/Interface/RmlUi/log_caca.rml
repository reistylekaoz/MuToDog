<rml>
<head>
	<title>Log de caça</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="log_caca.rcss"/>
</head>
<body data-model="log_caca">
	<!-- MuToDog (MU Estudo, rodada 11): Log de caça (CLogCacaWindow, tecla K), no jeito do cliente Godot (log_caca.gd):
	     linhas de rótulo e valor, vão entre os grupos, o título do Boneco de Treino e o Zerar embaixo. Arrasta segurando
	     (drag: drag no #panel), botão direito volta pro canto. Geometria em px da tela de referência 640 x 480 (.stage). -->
	<!-- bound-geometry: o painel segue o ponteiro quando arrasta (left/top do lugar que o jogador escolheu) -->
	<div id="screen" class="stage">
		<div id="panel" data-style-left="left" data-style-top="top"
		     data-event-dragstart="log_drag_start" data-event-drag="log_drag" data-event-dragend="log_drag_end"
		     data-event-mousedown="log_mouse_down">
			<div id="title">Log de caça (K)</div>
			<div data-for="r : rows" data-attr-class="'row ' + r.kind">
				<span class="label" data-if="r.kind == 'linha'">{{r.label}}:</span><span class="label" data-if="r.kind == 'titulo'">{{r.label}}</span><span class="value">{{r.value}}</span>
			</div>
			<div id="reset" data-event-click="log_reset">Zerar</div>
		</div>
	</div>
</body>
</rml>
