<rml>
<head>
	<title>Reset System</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="reset_system.rcss"/>
</head>
<body data-model="reset_system">
	<!-- MuToDog (MU Estudo): Reset System e Grand Reset System (CResetSystemWindow), no jeito do
	     cliente Godot (janela_reset.gd). #bar_icons sao os icones da barra de baixo (agenda e reset,
	     o do reset do lado da agenda), sempre a mostra no jogo: o do reset pisca quando o reset
	     (ready 1) ou o grand reset (ready 2) libera e abre a janela. #panel e a janela, so com open.
	     Geometria em px da tela de referencia 640 x 480: a janela no .stage, os icones no .hud-board. -->
	<div id="board" class="hud-board">
		<div id="bar_icons">
			<div id="icon_agenda" data-attr-data-hint="'Horário dos eventos (H)'"><img class="hud-icon" src="menu_f10/agenda.tga"/></div>
			<div id="icon_reset" data-class-ready="ready == 1" data-class-ready-grand="ready == 2"
			     data-attr-data-hint="'Reset System'" data-event-click="reset_icon_click">
				<div id="icon_glow"></div>
				<img class="hud-icon" data-if="ready != 2" src="menu_f10/reset.tga"/>
				<img class="hud-icon" data-if="ready == 2" src="menu_f10/grand_reset.tga"/>
			</div>
		</div>
	</div>
	<div id="screen" class="stage dp">
		<div id="panel" data-if="open">
			<div id="title">Reset System</div>
			<div id="tabs">
				<div class="tab" data-class-selected="tab == 0" data-event-click="reset_tab(0)">Reset</div>
				<div class="tab" data-class-selected="tab == 1" data-event-click="reset_tab(1)">Grand Reset</div>
			</div>
			<div id="head" data-if="enabled">
				<div id="head_text">{{title}}</div>
				<img id="head_icon" data-if="tab == 0" src="menu_f10/reset.tga"/>
				<img id="head_icon_grand" data-if="tab == 1" src="menu_f10/grand_reset.tga"/>
			</div>
			<div id="message" data-if="message != ''">{{message}}</div>
			<div id="rows">
				<div class="row" data-for="row : rows" data-attr-class="'row ' + row.look">
					<span class="label">{{row.label}}</span>
					<span class="value">{{row.value}}</span>
				</div>
				<div id="note">{{note}}</div>
			</div>
			<div id="do" data-if="enabled" data-class-disabled="!can_act" data-event-click="reset_do">{{action}}</div>
			<div id="close" data-event-click="reset_close">Fechar</div>
		</div>
	</div>
</body>
</rml>
