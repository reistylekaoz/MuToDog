/* fim dos sprites */
body { pointer-events: none; }
#screen { pointer-events: none; }

#panel {
	position: absolute;
	left: 170dp;
	top: 60dp;
	width: 300dp;
	height: 340dp;
	background-color: rgba(8, 10, 14, 240);
	border: 1dp #3e4652;
	pointer-events: auto;
	font-family: "token(font-body)";
	color: #e9edf3;
}
#title {
	position: absolute;
	left: 0dp;
	top: 6dp;
	width: 300dp;
	height: 16dp;
	text-align: center;
	font-family: "token(font-title)";
	font-size: 12dp;
	line-height: 16dp;
	color: #dae0ea;
}
#rule { position: absolute; left: 8dp; top: 26dp; width: 284dp; height: 1dp; background-color: #3e4652; }
#lista, #escolher, #moeda, #preco { position: absolute; left: 0dp; top: 0dp; width: 300dp; height: 340dp; }

.art { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; }
.section { position: absolute; left: 10dp; width: 280dp; font-size: 9dp; line-height: 12dp; color: #ffe08a; }
#deliv_title { top: 32dp; }
#offers_title { top: 120dp; }
#deliv { position: absolute; left: 10dp; top: 46dp; width: 280dp; height: 68dp; border: 1dp #262b33; }
#offers { position: absolute; left: 10dp; top: 134dp; width: 280dp; height: 132dp; border: 1dp #262b33; }
#bag { position: absolute; left: 10dp; top: 48dp; width: 280dp; height: 218dp; border: 1dp #262b33; }

.row { display: block; position: relative; height: 22dp; border-bottom: 1dp #161a20; }
.row .art { left: 2dp; top: 1dp; width: 20dp; height: 20dp; }
.row .name { position: absolute; left: 26dp; top: 0dp; width: 118dp; font-size: 8dp; line-height: 22dp; color: #e9edf3; white-space: nowrap; overflow: hidden; }
.row .name.wide { width: 240dp; }
.row .info { position: absolute; left: 146dp; top: 0dp; width: 76dp; text-align: right; font-size: 8dp; line-height: 22dp; color: #7d8796; white-space: nowrap; overflow: hidden; }
.row .info.good { color: #78e678; }
.row .info.price { color: #ffe08a; }
.row .act {
	position: absolute;
	left: 226dp;
	top: 3dp;
	width: 44dp;
	height: 15dp;
	text-align: center;
	font-size: 8dp;
	line-height: 15dp;
	background-color: #1e2228;
	border: 1dp #3e4652;
	cursor: pointer;
	color: #b9c1cd;
}
.row .act:hover { border-color: #78bfff; color: #ffffff; }
.row.pick { cursor: pointer; }
.row.pick:hover { background-color: rgba(120, 191, 255, 30); }
.none { display: block; padding: 6dp; font-size: 8dp; line-height: 11dp; color: #7d8796; }

.step { position: absolute; left: 10dp; top: 32dp; width: 280dp; font-size: 9dp; line-height: 12dp; color: #ffe08a; }
.picked { position: absolute; left: 10dp; top: 48dp; width: 280dp; height: 30dp; }
.picked .box { position: absolute; left: 0dp; top: 0dp; width: 28dp; height: 28dp; background-color: #09101b; border: 1dp #3e4652; border-radius: 4dp; }
.picked .label { position: absolute; left: 36dp; top: 0dp; width: 244dp; font-size: 9dp; line-height: 30dp; color: #e9edf3; white-space: nowrap; overflow: hidden; }

#coins { position: absolute; left: 10dp; top: 86dp; width: 284dp; height: 180dp; }
/* 16 moedas em 3 linhas de 6 (acima do Voltar) */
.coin { float: left; position: relative; width: 46dp; height: 58dp; margin-right: 1dp; cursor: pointer; }
.coin .box { position: absolute; left: 8dp; top: 0dp; width: 30dp; height: 30dp; background-color: #09101b; border: 1dp #3e4652; border-radius: 4dp; }
.coin:hover .box { border-color: #78bfff; background-color: #10213a; }
.coin .label { position: absolute; left: 0dp; top: 33dp; width: 46dp; text-align: center; font-size: 7dp; line-height: 9dp; color: #b9c1cd; }
.coin:hover .label { color: #ffffff; }

#price_row { position: absolute; left: 10dp; top: 92dp; width: 280dp; height: 26dp; }
#price_field { position: absolute; left: 0dp; top: 2dp; width: 150dp; height: 22dp; padding: 3dp 6dp; font-size: 11dp; line-height: 14dp; }
#price_coin { position: absolute; left: 158dp; top: 1dp; width: 24dp; height: 24dp; }
#price_coin_name { position: absolute; left: 186dp; top: 0dp; width: 94dp; font-size: 9dp; line-height: 26dp; color: #ffe08a; white-space: nowrap; overflow: hidden; }
#price_help { position: absolute; left: 10dp; top: 124dp; width: 280dp; font-size: 8dp; line-height: 11dp; color: #7d8796; }

.button {
	position: absolute;
	top: 274dp;
	height: 18dp;
	text-align: center;
	font-size: 9dp;
	line-height: 18dp;
	background-color: #1e2228;
	border: 1dp #3e4652;
	cursor: pointer;
	color: #b9c1cd;
}
.button:hover { border-color: #78bfff; color: #ffffff; }
.button.main { color: #ffffff; border-color: #78bfff; background-color: #14243a; }
#sell_open { left: 10dp; width: 86dp; }
#site { left: 102dp; width: 104dp; }
#close { left: 212dp; width: 78dp; }
#back1, #back2, #back3 { left: 212dp; width: 78dp; }
#sell { left: 10dp; width: 120dp; }

#note { position: absolute; left: 10dp; top: 298dp; width: 280dp; text-align: center; font-size: 8dp; line-height: 11dp; color: #78e678; }
#hint { position: absolute; left: 10dp; top: 318dp; width: 280dp; text-align: center; font-size: 8dp; line-height: 11dp; color: #7d8796; }
