/* MuToDog (MU Estudo, rodada 11): barra do boss (boss_bar.rml), no jeito do cliente Godot (barra_boss.gd): no alto e no meio
   da tela, a barra de 240 x 10 com o nome em cima e a disputa embaixo. Px da tela de referência 640 x 480 (.stage). */
body { pointer-events: none; }
#screen { pointer-events: none; font-family: "token(font-body)"; }
#name, #end, #leader, #me, #hp { position: absolute; text-align: center; white-space: nowrap; font-effect: outline(1px #000000e6); }
#name { left: 179dp; top: 19dp; width: 280dp; background-color: #00000078; font-size: 8dp; line-height: 11dp; font-weight: bold; color: #ffe2a0; }
#bar { position: absolute; left: 199dp; top: 31dp; width: 240dp; height: 10dp; background-color: #0a0508d9; border: 1dp #ffc846cc; }
#under { position: absolute; left: 0dp; top: 0dp; width: 240dp; height: 10dp; }
#trail { position: absolute; left: 0dp; top: 0dp; width: 0dp; height: 10dp; background-color: #ffecc8c8; }
#fill { position: absolute; left: 0dp; top: 0dp; width: 0dp; height: 10dp; }
#shine { position: absolute; left: 0dp; top: 0dp; width: 240dp; height: 5dp; background-color: #ffffff30; }
#hp { left: 0dp; top: 1dp; width: 240dp; font-size: 6dp; line-height: 8dp; color: #ffffff; }
#marker { position: absolute; left: 177dp; top: 31dp; width: 19dp; height: 10dp; border: 1dp #ffc846cc; text-align: center; font-size: 7dp; line-height: 10dp; font-weight: bold; color: #ffffff; font-effect: outline(1px #000000e6); }
#end { left: 179dp; top: 45dp; width: 280dp; font-size: 8dp; line-height: 11dp; background-color: #000000b4; font-weight: bold; color: #ffc846; }
#leader { left: 179dp; top: 45dp; width: 280dp; font-size: 8dp; line-height: 11dp; background-color: #000000b4; font-weight: bold; color: #ffc846; }
#leader.eu { color: #78e678; }
#leader.pisca { color: #ffffff; }
#me { left: 179dp; top: 56dp; width: 280dp; font-size: 7dp; line-height: 10dp; color: #dde1ea; background-color: #000000b4; }
.crown { display: inline-block; position: relative; width: 9dp; height: 6dp; }
.crown span { position: absolute; background-color: #ffc846; }
#leader.eu .crown span { background-color: #78e678; }
#leader.pisca .crown span { background-color: #ffffff; }
.cb { left: 0dp; top: 4dp; width: 9dp; height: 2dp; }
.c1 { left: 0dp; top: 1dp; width: 2dp; height: 3dp; }
.c2 { left: 3dp; top: 0dp; width: 3dp; height: 4dp; }
.c3 { left: 7dp; top: 1dp; width: 2dp; height: 3dp; }
/* rodada 20: o aviso do golpe especial, embaixo da disputa */
#golpe { position: absolute; left: 119dp; top: 70dp; width: 400dp; text-align: center; white-space: nowrap; font-size: 10dp; line-height: 14dp; font-weight: bold; color: #ff6a30; background-color: #000000a0; font-effect: outline(1px #000000e6); }
