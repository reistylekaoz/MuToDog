/* MuToDog (MU Estudo, rodada 13): Missões (missoes.rml), no jeito do cliente Godot (janela_quests_main.gd): janela de
   470 x 300 no meio da tela; na lista, missões ativas na esquerda (172) e a ficha na direita; no Zoak, a ficha ocupa a
   largura toda. Px da tela de referência 640 x 480 (.stage). */
body { pointer-events: none; }
#screen { pointer-events: none; }

#panel {
	position: absolute;
	left: 85dp;
	top: 90dp;
	width: 470dp;
	height: 300dp;
	background-color: rgba(9, 11, 13, 245);
	border: 1dp #3e4652;
	pointer-events: auto;
	font-family: "token(font-body)";
	color: #ebedf1;
}
#title {
	position: absolute;
	left: 0dp;
	top: 4dp;
	width: 470dp;
	height: 16dp;
	text-align: center;
	font-family: "token(font-title)";
	font-size: 12dp;
	line-height: 16dp;
	color: #dde1e7;
}
#heading { position: absolute; left: 10dp; top: 25dp; width: 450dp; font-family: "token(font-title)"; font-size: 10dp; line-height: 13dp; color: #dde1e7; }

#list {
	position: absolute;
	left: 8dp;
	top: 26dp;
	width: 172dp;
	height: 238dp;
	background-color: #090b0f;
	border: 1dp #3e4652;
	overflow-y: auto;
}
.row { display: block; position: relative; height: 13dp; margin: 0dp 4dp; font-size: 9dp; line-height: 13dp; white-space: nowrap; overflow: hidden; }
.row.header { margin-top: 3dp; font-family: "token(font-title)"; color: #dde1e7; }
.row.header .mark { display: inline-block; width: 6dp; height: 6dp; margin: 0dp 5dp 1dp 1dp; background-color: #6f7a8a; }
.row.quest { margin-left: 12dp; padding-left: 4dp; color: #f0be5a; cursor: pointer; border: 1dp #00000000; }
.row.quest.ready { color: #78e196; }
.row.quest:hover { border-color: #3e4652; }
.row.quest.selected { background-color: rgba(120, 191, 255, 46); border-color: #78bfff; }
#empty { display: block; margin: 8dp; font-size: 9dp; line-height: 13dp; color: #8a94a4; }
#summary { position: absolute; left: 8dp; top: 278dp; width: 180dp; font-size: 9dp; line-height: 12dp; color: #a6aebb; }

#detail { position: absolute; left: 196dp; top: 26dp; width: 266dp; height: 238dp; }
#panel.zoak #detail { left: 8dp; top: 42dp; width: 454dp; height: 222dp; }
#none, #done {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 100%;
	height: 100%;
	background-color: #090b0f;
	border: 1dp #3e4652;
	box-sizing: border-box;
	text-align: center;
	font-size: 9dp;
	color: #8a94a4;
}
#none { padding-top: 110dp; }
#done { padding-top: 90dp; }
#done_title { font-size: 11dp; line-height: 15dp; font-weight: bold; color: #78e196; }
#done_text { margin-top: 6dp; font-size: 9dp; line-height: 12dp; color: #ebedf1; }

#sheet { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; }
#name {
	display: block;
	height: 22dp;
	background-color: rgba(240, 190, 90, 26);
	border: 1dp #3e4652;
	text-align: center;
	font-family: "token(font-title)";
	font-size: 12dp;
	line-height: 22dp;
	color: #78e196;
}
#box {
	position: absolute;
	left: 0dp;
	top: 28dp;
	right: 0dp;
	bottom: 0dp;
	padding: 5dp 8dp;
	background-color: #090b0f;
	border: 1dp #3e4652;
	overflow: hidden;
}
#story { display: block; max-height: 66dp; overflow: hidden; font-size: 8dp; line-height: 11dp; color: #ebedf1; }
#objective { display: block; margin-top: 4dp; font-size: 9dp; line-height: 12dp; font-weight: bold; color: #ebedf1; }
#warn { display: block; font-size: 8dp; line-height: 11dp; color: #eb5a50; }
.band { display: block; position: relative; height: 13dp; margin-top: 4dp; padding-left: 14dp; background-color: rgba(240, 190, 90, 41); font-family: "token(font-title)"; font-size: 9dp; line-height: 13dp; color: #dde1e7; }
.band .dot { position: absolute; left: 4dp; top: 4dp; width: 5dp; height: 5dp; background-color: #f0be5a; }
#bar { display: block; position: relative; height: 12dp; margin: 3dp 6dp 0dp 6dp; background-color: rgba(0, 0, 0, 128); font-size: 9dp; line-height: 12dp; }
#fill { position: absolute; left: 0dp; top: 0dp; height: 12dp; background-color: rgba(240, 190, 90, 89); }
#monster { position: absolute; left: 4dp; top: 0dp; color: #78e196; }
#progress { position: absolute; right: 4dp; top: 0dp; color: #ebedf1; }
.prize { display: block; height: 12dp; margin: 2dp 6dp 0dp 6dp; padding-left: 4dp; background-color: rgba(0, 0, 0, 89); font-size: 9dp; line-height: 12dp; color: #f0be5a; }

.button {
	position: absolute;
	top: 274dp;
	height: 18dp;
	text-align: center;
	font-size: 9dp;
	line-height: 18dp;
	background-color: #1e2228;
	border: 1dp #3e4652;
	cursor: pointer;
	color: #ffffff;
}
.button:hover { border-color: #78bfff; }
.button.disabled { color: #4a515c; cursor: default; }
.button.disabled:hover { border-color: #3e4652; }
#abandon { left: 196dp; width: 110dp; }
#abandon.confirm { color: #eb5a50; border-color: #eb5a50; }
#accept, #deliver { left: 8dp; width: 120dp; }
#deliver { color: #78e196; }
#close { left: 382dp; width: 80dp; }
#hint { position: absolute; left: 10dp; top: 277dp; width: 360dp; font-size: 9dp; line-height: 12dp; color: #f0be5a; }
