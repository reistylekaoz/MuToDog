/* MuToDog (MU Estudo, rodada 13): rastreio das missões (rastreio_missoes.rml), no jeito do cliente Godot
   (rastreio_quests.gd): 128 de largura na borda direita (508, 118), 28 por missão. Px da tela de referência 640 x 480. */
body { pointer-events: none; }
#screen { pointer-events: none; }

#panel {
	position: absolute;
	left: 508dp;
	top: 118dp;
	width: 128dp;
	padding: 0dp 2dp 2dp 2dp;
	background-color: rgba(9, 11, 13, 215);
	border: 1dp #3e4652;
	box-sizing: border-box;
	pointer-events: auto;
	drag: drag;
	cursor: move;
	font-family: "token(font-body)";
	color: #ebedf1;
}
#title { display: block; height: 12dp; text-align: right; padding-right: 4dp; font-size: 8dp; line-height: 12dp; color: #c0c6d0; }
.quest { display: block; height: 28dp; margin-top: 1dp; }
.name {
	display: block;
	position: relative;
	height: 12dp;
	padding-left: 6dp;
	background-color: rgba(255, 255, 255, 14);
	font-size: 8dp;
	line-height: 12dp;
	color: #f0be5a;
	white-space: nowrap;
	overflow: hidden;
}
.name .tag { position: absolute; left: 0dp; top: 0dp; width: 3dp; height: 12dp; background-color: #f0be5a; }
.quest.ready .name { color: #78e196; }
.quest.ready .name .tag { background-color: #78e196; }
.bar { display: block; position: relative; height: 12dp; margin-top: 1dp; background-color: rgba(0, 0, 0, 200); font-size: 8dp; line-height: 12dp; }
.fill { position: absolute; left: 0dp; top: 0dp; height: 12dp; background-color: rgba(240, 190, 90, 89); }
.label { position: absolute; left: 5dp; top: 0dp; color: #ebedf1; white-space: nowrap; }
.count { position: absolute; right: 4dp; top: 0dp; color: #ebedf1; }
