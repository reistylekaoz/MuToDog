/* MuToDog (MU Estudo): o menu do F10 em grade (menu_f10.rml), no jeito do cliente Godot (janela_atalhos.gd):
   casas de 72 x 72 com 6 de vao, 6 por linha. Px da tela de referencia 640 x 480 (.stage). O tema obsidiana poe por
   cima a moldura e o botao do Meshy (tools/obsidiana_theme/menu_f10.rcss). */
body { pointer-events: none; }
#screen { pointer-events: none; }

#panel {
	position: absolute;
	left: 79dp;
	top: 38dp;
	width: 482dp;
	height: 404dp;
	background-color: rgba(8, 10, 14, 240);
	border: 1dp #3e4652;
	pointer-events: auto;
	font-family: "token(font-body)";
	color: #e9edf3;
}
#title {
	position: absolute;
	left: 0dp;
	top: 6dp;
	width: 482dp;
	height: 16dp;
	text-align: center;
	font-family: "token(font-title)";
	font-size: 12dp;
	line-height: 16dp;
	color: #dae0ea;
}
#help {
	position: absolute;
	left: 10dp;
	top: 28dp;
	width: 462dp;
	font-size: 9dp;
	line-height: 12dp;
	color: #78bfff;
}
#grid {
	position: absolute;
	left: 10dp;
	top: 44dp;
	width: 470dp;
	height: 310dp;
}
.cell {
	float: left;
	position: relative;
	width: 70dp;
	height: 70dp;
	margin-right: 6dp;
	margin-bottom: 6dp;
	background-color: #09101b;
	border: 1dp #3e4652;
	border-radius: 4dp;
	cursor: pointer;
}
.cell:hover { background-color: #18202e; border-color: #78bfff; }
.halo {
	position: absolute;
	left: 12.6dp;
	top: 5.6dp;
	width: 44.8dp;
	height: 44.8dp;
	border-radius: 22.4dp;
	background-color: rgba(120, 191, 255, 28);
}
.cell:hover .halo { background-color: rgba(120, 191, 255, 41); }
.icon {
	position: absolute;
	left: 15dp;
	top: 8dp;
	width: 40dp;
	height: 40dp;
}
.key {
	position: absolute;
	right: 2dp;
	top: 2dp;
	height: 10dp;
	padding: 0dp 3dp;
	background-color: #1a4f93;
	border: 1dp #78bfff;
	border-radius: 2dp;
	font-size: 7dp;
	line-height: 10dp;
	color: #ffffff;
}
.name {
	position: absolute;
	left: 1dp;
	bottom: 3dp;
	width: 68dp;
	text-align: center;
	font-size: 8dp;
	line-height: 9dp;
	color: #dae0ea;
}
.cell:hover .name { color: #ffffff; }
#rule {
	position: absolute;
	left: 8dp;
	top: 358dp;
	width: 466dp;
	height: 1dp;
	background-color: #3e4652;
}
#hint {
	position: absolute;
	left: 10dp;
	top: 362dp;
	width: 462dp;
	height: 12dp;
	font-size: 9dp;
	line-height: 12dp;
	color: #b9c1cd;
}
#close {
	position: absolute;
	left: 211dp;
	top: 380dp;
	width: 60dp;
	height: 17dp;
	text-align: center;
	font-size: 9dp;
	line-height: 17dp;
	background-color: #1e2228;
	border: 1dp #3e4652;
	cursor: pointer;
}
#close:hover { border-color: #78bfff; color: #ffffff; }
