/* Modern theme for CCharacterInfoWindow -- same forged-dialog chrome recipe as CMyInventory
   (shell-edge/groove/gradient panel fill, rail-with-rivet header, bordered square icon buttons),
   not the generic .modern-frame/.modern-frame-crimson treatment: this window docks in the same
   right-dock row as CMyInventory/CMyQuestInfoWindow/CPetInfoWindow/CPartyInfoWindow and should
   read as the same family when open side by side. #panel/shell-edge/groove/header-rail chrome now
   all come from docked_panel_frame.rcss, shared with the other three -- only genuinely
   window-specific content stays here. */

/* Right-hand pieces are pinned to #panel's edges, so they follow a wider or filled panel. */

#name, #classname, #servername {
	position: absolute;
	left: 0;
	top: 12px;
	width: 100%;
	text-align: center;
	font-weight: bold;
	font-size: 12px;
	font-family: "token(font-body)";
	pointer-events: none;
	font-effect: shadow(0px 1px #000000);
}
#name { color: token(text-warm); }
#classname, #servername { top: 27px; color: token(text-secondary); font-weight: normal; font-size: 11px; }

.summary-fill {
	position: absolute;
	left: 12px;
	right: 13px;
	top: 48px;
	height: 71px;
	background-color: token(surface-panel);
	border-radius: token(radius-sm)dp;
	pointer-events: none;
}

/* 10px, one line each: the longest lines (a level-400 EXP pair, the fruit counts) fit the 165px
   summary box; the level-up points get a line of their own (beside the level they overlapped). */
.level-text, .levelup-point-text, .exp-text, .point-probability-text, .point-text {
	display: block;
	position: absolute;
	left: 18px;
	font-size: 10px;
	font-family: "token(font-body)";
	white-space: nowrap;
	pointer-events: none;
}
.level-text { top: 51px; color: token(accent-gold-hover); font-weight: bold; }
.levelup-point-text { top: 63px; color: token(accent-gold-hover); font-weight: bold; }
.exp-text { top: 76px; color: token(text-primary); }
.point-probability-text { top: 89px; color: token(accent-steel-hover); }
.point-text { top: 102px; color: token(accent-steel-hover); }

.attr-textbox {
	position: absolute;
	left: 11px;
	right: 9px;
	height: 21px;
	background-color: token(surface-control);
	border-radius: token(radius-sm)dp;
	pointer-events: none;
}
.attr-textbox-str { top: 120px; }
/* AGI and VIT sit one line (13px) below the original rows (175/240), so STR has room for its third line (the
   critical damage rate); VIT's room below takes the line back, so ENE and CMD keep their places. */
.attr-textbox-agi { top: 188px; }
.attr-textbox-vit { top: 253px; }
.attr-textbox-ene { top: 295px; }
.attr-textbox-cmd { top: 350px; }

.attr-label, .attr-value {
	display: block;
	position: absolute;
	text-align: center;
	font-weight: bold;
	font-size: 12px;
	font-family: "token(font-body)";
	pointer-events: none;
}
.attr-label { left: 12px; width: 74px; color: token(text-secondary); }
.attr-value { left: 86px; right: 18px; color: rgb(0, 120, 248); }
.attr-label-str, .attr-value-str { top: 126px; }
.attr-label-agi, .attr-value-agi { top: 194px; }
.attr-label-vit, .attr-value-vit { top: 259px; }
.attr-label-ene, .attr-value-ene { top: 301px; }
.attr-label-cmd, .attr-value-cmd { top: 356px; }

.attr-lines { position: absolute; width: 160px; pointer-events: none; }
.attr-lines span { display: block; line-height: 13px; font-size: 12px; font-family: "token(font-body)"; white-space: nowrap; }
.attr-lines-str { left: 20px; top: 145px; }
.attr-lines-agi { left: 20px; top: 212px; }
.attr-lines-vit { left: 20px; top: 277px; }
.attr-lines-ene { left: 18px; top: 319px; }

/* Flat "+" button -- a generic affordance, kept simple rather than a full forged-metal square
   (too small at 16x15 to carry that much chrome); recolored to this window's own metal/border
   tokens instead of the generic accent-steel so it still reads as part of the same palette. */
.stat-btn {
	display: block;
	position: absolute;
	right: 14px;
	width: 16px;
	height: 15px;
	background-color: token(metal-dark);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)dp;
	text-align: center;
	line-height: 13px;
	font-weight: bold;
	font-size: 11px;
	color: token(text-warm);
	cursor: pointer;
	pointer-events: auto;
}
.stat-btn:hover { color: token(accent-gold-hover); border-color: token(border-hover); }
/* data-class-hidden: base.rcss's .hidden has this rule's specificity and loses to its display. */
.stat-btn.hidden, .levelup-point-text.hidden, .attr-label.hidden, .attr-value.hidden { display: none; }
.stat-btn-str { top: 122px; }
.stat-btn-agi { top: 190px; }
.stat-btn-vit { top: 255px; }
.stat-btn-ene { top: 297px; }
.stat-btn-cmd { top: 352px; }
/* The Rage Fighter's second Vitality line (melee damage) moves the Energy row down a line too; it has no
   Command row, so Energy keeps its room below. */
#panel.vitality-two-lines .attr-textbox-ene { top: 308px; }
#panel.vitality-two-lines .attr-label-ene, #panel.vitality-two-lines .attr-value-ene { top: 314px; }
#panel.vitality-two-lines .attr-lines-ene { top: 332px; }
#panel.vitality-two-lines .stat-btn-ene { top: 310px; }

/* Action row: base.rcss's .modern-icon-btn-px at its own default geometry (top:392/37x26) --
   same shared class CMyInventory's Exit/Repair/My Shop/Expand use, just this window's own left
   offsets and glyphs. */
.chainfo-btn-exit        { left: 13px;  color: #8bb3dd; border-color: #2d4865; }
.chainfo-btn-quest       { left: 54px; }
.chainfo-btn-pet         { left: 95px; }
.chainfo-btn-masterlevel { left: 136px; }

/* Outlaw level, from the model's pk_level -- the original's UI::Chat::SetPlayerColor() palette,
   which used to arrive as a colour string C++ built. #name's own colour is the fallback. */
#name.pk-0 { color: rgb(150, 255, 240); }
#name.pk-1 { color: rgb(100, 120, 255); }
#name.pk-2 { color: rgb(140, 180, 255); }
#name.pk-3 { color: rgb(200, 220, 255); }
#name.pk-4 { color: rgb(85, 167, 255); }
#name.pk-5 { color: rgb(255, 80, 30); }
#name.pk-6 { color: rgb(255, 0, 0); }

/* Where an attribute's total comes from, from the model's *_value_source. The original coloured
   the value for each of the three; the base colour lives on .attr-value above. */
.attr-value.attr-boosted { color: rgb(100, 150, 255); }
.attr-value.attr-potion  { color: rgb(20, 134, 255); }

.attr-lines span { color: token(text-primary); }
.attr-lines span.boosted { color: rgb(100, 150, 255); }
.attr-lines span.buffed { color: token(accent-gold); }
/* A line with a hint (the damage, the critical damage rate) shows it while the pointer is over it. */
.attr-lines span.hinted { pointer-events: auto; }

/* MuToDog: campo "Por clique" (quantos pontos cada + manda), a direita dos pontos livres. */
.stat-amount-label { position: absolute; right: 60px; top: 63px; color: token(text-primary); font-size: 10px; white-space: nowrap; pointer-events: none; }
.stat-amount-field { position: absolute; right: 14px; top: 61px; width: 42px; height: 15px; font-size: 10px; padding: 0 3px; }
.stat-amount-label.hidden, .stat-amount-field.hidden { display: none; }

/* ---- Obsidiana e prata, rodada 6: janela do personagem no jeito do cliente Godot. Cada atributo numa caixa
   cha_caixa (placa de prata com o nome, recesso com o valor), + do Tema 3 (cha_mais, o quadro claro), resumo com filete de prata. ---- */
@spritesheet ob-cha-mais {
	src: arte/cha_mais.tga;
	resolution: 4x;
	ob-mais: 0px 0px 64px 60px;
}
.summary-fill { background-color: #04060a; border: 1px #788291; border-radius: 0; }
.attr-textbox { background-color: transparent; border-radius: 0; decorator: image(arte/cha_caixa.tga); }
.attr-label { left: 11px; width: 72px; color: #dae0ea; font-family: "token(font-title)"; }
.attr-value { color: #78bfff; }
.level-text, .levelup-point-text { color: #78bfff; }
.stat-btn {
	width: 16px;
	height: 15px;
	background-color: transparent;
	border-width: 0;
	decorator: image(ob-mais);
	color: transparent;
	font-size: 1px;
}
.stat-btn:hover { color: transparent; opacity: 0.8; }
.chainfo-btn-exit { color: #e9edf3; border-color: #3e4652; }

/* ---- MU Estudo: painel em dp (tools/estudo_dp.py; gerado, nao edite daqui pra baixo) ---- */
/* Shared, cross-window RCSS for the modern theme: generic (non-positional) rules reused by more
   than one migrated window, plus the anchor/center/stretch layout utility classes every window
   uses. Every migrated window's <head> links this file first, then its own per-window positional
   .rcss.

   Second generation: blackened iron / dark forged metal. Colors/borders below are named against
   this theme's design-token table -- keep the trailing token-name comment next to each value;
   that table is the source of truth.

   Depth primitives (.modern-frame/.modern-panel/.modern-inset, .btn/.checkbox-box below) simulate
   raised/recessed surfaces using per-side border-color bevels plus `decorator:
   linear-gradient(...)`. Light source is fixed upper-left: a RAISED surface gets a lighter
   top/left border/gradient corner, darker bottom/right; a RECESSED surface inverts both. Never
   mix the two directions on one element.

   Real `box-shadow` (inset/outset, blur, multiple shadows) is supported by this renderer and used
   directly for shadow/glow effects a border color can't express; the per-side bevel technique
   stays the right tool for a surface's own edge. Engine note: this engine's rgba() parses alpha
   as a 0-255 integer, not a 0-1 CSS float -- every box-shadow color below is pre-converted to the
   0-255 form. */

body {
	width: 100%;
	height: 100%;
	margin: 0;
	pointer-events: none;
	/* A panel's scale before anything places it; a placed panel sets its own. */
	--root-scale: 1;
}

/* Full-screen dim overlay for modal-style windows (SysMenuWin/OptionWin). */
#backdrop {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background-color: token(surface-backdrop);
	pointer-events: auto;
}

/* Server-selection controls use the character choices' neutral iron and gold selection
   treatment. The consuming document owns dimensions, alignment and population gauges. */
.server-group-btn, .server-option-btn {
	cursor: pointer;
	pointer-events: auto;
	color: token(text-secondary);
	background-color: #0f1114;
	decorator: linear-gradient(to bottom, rgba(255, 255, 255, 8), transparent 40%),
		linear-gradient(to bottom, #171a1e, #0c0d0f 58%, #070809);
	border: 1dp token(border-frame);
	border-radius: token(radius-sm)px;
	font-family: "token(font-body)";
}
.server-group-btn:hover, .server-option-btn:hover {
	color: token(accent-gold-hover);
	border-color: token(border-hover);
}
.server-group-btn:active, .server-option-btn:active {
	box-shadow: inset 0 1dp 3dp rgba(0, 0, 0, 184);
}
.server-group-btn.checked {
	color: token(text-warm);
	border-color: token(accent-gold-hover);
	background-color: #13171e;
	box-shadow: inset 2dp 0 0 token(accent-gold-hover);
}
.server-option-btn {
	color: token(server-button);
}
.server-option-btn.gray {
	color: token(server-button-gray);
}
.server-option-btn.gray:hover {
	color: token(text-primary);
}
.server-option-btn.orange {
	color: token(server-button-orange);
}
.server-option-btn.orange:hover {
	color: token(accent-gold-hover);
}
/* A VIP type with the theme color "silver" (Data/Local/ServerList.json). */
.server-option-btn.silver {
	color: token(server-button-silver);
}
.server-option-btn.silver:hover {
	color: #c3c9d3;
}
.server-group-btn:active .button-label, .server-option-btn:active .button-label {
	transform: translateY(1dp);
}

.checkbox-row {
	position: absolute;
	cursor: pointer;
	pointer-events: auto;
}
/* Small recessed control whose gold indicates checked state, not the theme's general-purpose
   accent-gold token (noticeably brighter/more saturated than this control's own tone). No
   decorator/bevel on the unchecked state -- flat by design. */
.checkbox-box {
	display: inline-block;
	width: 12dp;
	height: 12dp;
	background-color: #0b0c0e;
	border-width: 1dp;
	border-color: #38414e;
	border-radius: token(radius-sm)dp;
	box-shadow: inset 0 1dp 2dp rgba(0, 0, 0, 140);
}
.checkbox-box.checked {
	background-color: #225e9d;
	decorator: linear-gradient(to bottom, #5e9adb, #225e9d);
	border-color: #3375bb;
}
.checkbox-label {
	position: absolute;
	left: 18dp; /* 12dp box + reference's own 6dp flex gap */
	top: 0;
	white-space: nowrap;
	font-family: "token(font-body)";
	font-size: 9dp;
	color: token(text-secondary);
}

/* Flat dark-iron fill with a visible metal-frame border -- steel is the general interactive
   accent (hover/focus), gold is reserved for selected-state/text emphasis, never general button
   chrome. Per-side border bevel (light top/left, dark bottom/right) is the same "raised surface"
   language .modern-frame uses -- a single uniform border-color would read as a web button, not a
   forged-metal one. Shared by every .btn consumer (sys_menu, msg_win, remember_password_prompt,
   char_make, char_sel_main, credit_win, mu_helper_bar, my_quest_info, server_select, login). */
.btn {
	position: absolute;
	width: 108dp;
	height: 30dp;
	text-align: center;
	vertical-align: middle;
	line-height: 30dp;
	cursor: pointer;
	font-family: "token(font-body)";
	font-size: 9dp;
	letter-spacing: 0.18dp;
	color: #a6b0be;
	background-color: #0f1114;
	decorator: linear-gradient(to bottom,
		rgba(255, 255, 255, 10),
		transparent 45%),
		linear-gradient(to bottom, #1d2126, #0f1114 58%, #090a0b);
	border-width: 1dp;
	border-color: #383f4a;
	border-radius: token(radius-sm)dp;
	pointer-events: auto;
	box-shadow:
		inset 0 1dp 0 rgba(192, 215, 240, 14),
		inset 0 -1dp 0 #000000,
		0 1dp 2dp rgba(0, 0, 0, 153);
}
.btn:hover {
	color: #8ab7e7;
	border-color: #4e5b6f;
	decorator: linear-gradient(to bottom,
		rgba(255, 255, 255, 13),
		transparent 45%),
		linear-gradient(to bottom, #21262e, #101317 58%, #090a0c);
}
.btn:active {
	/* Real 1dp downward shift plus one inset shadow. Native :active pseudo-class -- unverified
	   against this branch's own mouse-input routing, but degrades gracefully if it never fires. */
	transform: translateY(1dp);
	box-shadow: inset 0 1dp 3dp rgba(0, 0, 0, 184);
}
.btn.disabled {
	pointer-events: none;
	background-color: #090a0b;
	color: token(semantic-neutral);
	border-color: rgba(56, 63, 73, 60); /* metal-mid's rgb @ 60 alpha, stays neutral when disabled, no gold */
	opacity: 0.55;
	cursor: default;
}

/* Opt-in primary/hero variant -- apply alongside .btn (class="btn btn-ok") for a window's one
   confirm-style action; plain .btn stays flat/neutral for a list of equal-weight actions (e.g.
   sys_menu.rcss's four stacked buttons). Overrides only color properties, not layout. Must stay
   textually after .btn/.btn:hover/.btn:active (equal specificity once combined on one element,
   so source order decides). */
.btn-ok {
	color: #6fabeb;
	background-color: #131d2b;
	decorator: linear-gradient(to bottom,
		rgba(183, 218, 255, 18),
		transparent 38%),
		linear-gradient(to bottom, #253852, #131d2b 58%, #0b0d11);
	border-color: #344761;
	box-shadow:
		inset 0 1dp 0 rgba(192, 223, 255, 23),
		inset 0 -1dp 0 #040506,
		0 2dp 5dp rgba(0, 0, 0, 128);
}
.btn-ok:hover {
	decorator: linear-gradient(to bottom,
		rgba(183, 218, 255, 26),
		transparent 38%),
		linear-gradient(to bottom, #2c4464, #162437 58%, #0e1115);
	border-color: #425c80;
}
/* No :active override -- the reference gives .btn-primary no separate pressed state either; the
   generic .btn:active above applies uniformly to both variants, matching its actual cascade. */
.btn-ok.disabled {
	/* Resets decorator/box-shadow to neutral -- two classes here outrank .btn-ok's one-class
	   declarations on specificity, so without this the crimson gradient/shadow would paint over
	   the disabled neutral fill. */
	decorator: none;
	box-shadow: none;
}

/* Shared icon-only button -- carved-iron FAB look, same gradient/shadow recipe as .btn/.btn-ok
   above.

   position:absolute against #panel directly, not nested in a positioned wrapper -- nesting under
   a bottom/right-anchored wrapper made buttons vanish entirely on this engine. */
.btn-icon {
	position: absolute;
	width: 54dp;
	height: 30dp;
	cursor: pointer;
	pointer-events: auto;
	text-align: center;
	line-height: 30dp;
	color: token(text-secondary);
	background-color: #0f1114;
	decorator: linear-gradient(to bottom,
		rgba(255, 255, 255, 11),
		transparent 40%),
		linear-gradient(to bottom, #1d2126, #101215 56%, #08090a);
	border: 1dp token(border-frame);
	border-radius: token(radius-sm)dp;
	box-shadow:
		0 2dp 5dp rgba(0, 0, 0, 133),
		inset 0 1dp 0 rgba(192, 215, 240, 18),
		inset 0 -1dp 0 #000000;
}
.btn-icon:hover {
	color: token(accent-gold-hover);
	border-color: token(border-hover);
	decorator: linear-gradient(to bottom,
		rgba(255, 255, 255, 15),
		transparent 40%),
		linear-gradient(to bottom, #21262e, #101317 56%, #090a0c);
	box-shadow:
		0 3dp 6dp rgba(0, 0, 0, 143),
		inset 0 1dp 0 rgba(138, 183, 231, 28),
		inset 0 -1dp 0 #000000;
}
.btn-icon:active {
	transform: translateY(1dp);
	background-color: #090a0b;
	decorator: none;
	box-shadow: inset 0 2dp 5dp rgba(0, 0, 0, 199);
}
/* background-color is a solid dark neutral, not token(surface-control) -- that token is already
   near-transparent, and combined with opacity:0.5 the button read as completely gone rather than
   dimmed. A solid fill dimmed by opacity reads as "disabled," not "absent." */
.btn-icon.disabled {
	pointer-events: none;
	opacity: 0.55;
	cursor: default;
	color: token(text-secondary);
	decorator: none;
	background-color: #090a0b;
	border: 1dp token(border-frame);
	box-shadow: none;
}
/* Opt-in hero variant for a bar's one primary action (e.g. Menu) -- same .btn-ok convention as
   above: add alongside .btn-icon, overrides only color properties. */
.btn-icon-primary {
	color: token(text-warm);
	background-color: #101925;
	decorator: linear-gradient(to bottom,
		rgba(183, 218, 255, 18),
		transparent 36%),
		linear-gradient(to bottom, #1c2a3e, #101925 58%, #090b0e);
	border-color: #344761;
	box-shadow:
		0 2dp 5dp rgba(0, 0, 0, 133),
		inset 0 1dp 0 rgba(192, 223, 255, 20),
		inset 0 -1dp 0 #040506;
}
.btn-icon-primary:hover {
	color: token(accent-gold-hover);
	border-color: #425c80;
	decorator: linear-gradient(to bottom,
		rgba(183, 218, 255, 26),
		transparent 36%),
		linear-gradient(to bottom, #253852, #131d2b 58%, #0b0d11);
}
/* font-family/size often need redeclaring directly on the label span -- inheritance from a
   data-model-bound ancestor silently fails for text in this RmlUi build.
   DejaVu Sans, not token(font-body)/Liberation Sans -- these labels are Unicode glyphs and
   Liberation Sans's cmap only covers one of them. RmlUi has no per-glyph fallback across loaded
   faces (only a single whole-family fallback_face), so this can't be split per-character within
   one font-family. */
.btn-icon-label {
	color: token(text-primary);
	font-weight: bold;
	font-family: "DejaVu Sans";
}
.btn-icon-primary .btn-icon-label {
	color: token(text-warm);
}
.btn-icon.disabled .btn-icon-label {
	color: token(text-disabled);
}

/* .btn-icon-item (the wrapper markup in login_main.rml/char_sel_main.rml) is deliberately
   unstyled -- no CSS rule, position:static by default. .btn-icon/.btn-icon-caption both resolve
   position:absolute directly against #panel, one level only (see .btn-icon's own comment). */
.btn-icon-caption {
	position: absolute;
	width: 72dp;
	line-height: 12dp;
	text-align: center;
	font-size: 9dp;
	color: token(text-secondary);
	font-family: "token(font-body)";
	white-space: nowrap;
}

/* Reusable window-layering primitives. Usage: apply .modern-frame to the outer positioned panel
   element itself (keeps its position/size), then add ONE decorative child div with .modern-panel,
   inset a few px on all sides, as the FIRST child (so it paints behind real content) -- the small
   reveal between the frame's inner edge and the panel's border is deliberate, a third visual band
   of the frame's own material. Real content stays a direct child of .modern-frame at its original
   position -- do NOT nest content inside .modern-panel, its inset would shift every child.

   This engine has no CSS variable mechanism, so a shared class can only carry structural
   properties portably; a window's own palette comes from a *named palette variant* modifier class
   (e.g. .modern-frame-crimson below) applied alongside the base class
   (class="modern-frame modern-frame-crimson") -- the variant only overrides color/decorator,
   .modern-frame's own border-width/mechanism still applies underneath. Position/size stay the
   consuming window's own responsibility either way. */
.modern-frame {
	background-color: rgba(15, 17, 19, 196); /* surface-panel's rgb @ 196 alpha -- can't use token(surface-panel) directly, it has no alpha channel of its own */
	decorator: linear-gradient(to bottom, rgba(28, 31, 35, 196) 0%, rgba(15, 17, 19, 196) 45%, rgba(8, 9, 10, 196) 100%);
	border-width: 2dp;
	border-top-color: rgba(82, 90, 102, 160); /* metal-edge's rgb @ 160 alpha: bevel-light, brighter than the fill for a real edge-catch */
	border-left-color: rgba(82, 90, 102, 160);
	border-bottom-color: rgba(0, 0, 0, 190); /* bevel-dark */
	border-right-color: rgba(0, 0, 0, 190);
}
.modern-panel {
	position: absolute;
	left: 4dp;
	right: 4dp;
	top: 4dp;
	bottom: 4dp;
	pointer-events: none;
	background-color: token(surface-recessed);
	decorator: linear-gradient(to bottom, rgba(13, 14, 16, 180) 0%, rgba(7, 7, 8, 180) 100%);
	border-width: 1dp;
	border-color: token(border-inner); /* the recessed content-well border this token exists for */
	border-top-color: rgba(0, 0, 0, 160); /* bevel-dark-inset: recessed relative to the frame */
	border-left-color: rgba(0, 0, 0, 160);
	border-bottom-color: rgba(74, 85, 102, 20); /* metal-warm-edge's rgb @ 20 alpha: bevel-light-inset, a faint warm catch */
	border-right-color: rgba(74, 85, 102, 20);
	border-radius: token(radius-md)dp;
}

/* Palette variant for the "real dialog" family (login/msg_win/my_quest_info/sys_menu/
   remember_password_prompt). Apply alongside .modern-frame/.modern-panel
   (class="modern-frame modern-frame-crimson"), not instead of them. Despite the name this isn't
   crimson itself (that's accent-crimson) -- it's a marginally warmer, slightly darker iron than
   plain .modern-frame; only title/label text and the checkbox go warm/gold. */
.modern-frame-crimson {
	background-color: #0c0d0f;
	decorator: linear-gradient(to bottom, #15171b, #0c0d0f 30%, #070809);
	border-top-color: rgba(74, 85, 102, 90); /* metal-warm-edge's rgb @ 90 alpha: a warm iron highlight catching the top edge */
	border-left-color: rgba(0, 0, 0, 160);
	border-right-color: rgba(0, 0, 0, 160);
	border-bottom-color: rgba(0, 0, 0, 220);
}
.modern-panel-crimson {
	background-color: #090a0b;
	decorator: linear-gradient(to bottom, #0f1113, #090a0b 55%, #060607);
	border-top-color: rgba(74, 85, 102, 45); /* metal-warm-edge's rgb @ 45 alpha */
	border-bottom-color: rgba(0, 0, 0, 240);
	border-left-color: #040506;
	border-right-color: #040506;
}

/* Thin accent line just inside .modern-frame -- border only, no fill, so the frame's own gradient
   still shows through. Apply as a direct child of .modern-frame, inset a few px more than
   .modern-panel (a fourth visual band, not a replacement for the frame/panel pair).
   Position/size stay the consuming window's own responsibility. */
.modern-frame-accent {
	position: absolute;
	pointer-events: none;
	border-width: 1dp;
}
.modern-frame-accent-crimson {
	border-color: rgba(56, 63, 73, 166); /* metal-mid's rgb @ 166 alpha */
	border-top-color: token(accent-steel-hover);
	border-bottom-color: rgba(0, 0, 0, 200);
}

/* Raised header/footer bands -- overlay bands painted after .modern-panel (not a repositioning of
   it), so title text/labels/buttons stay exactly where they are while a raised band draws across
   the top/bottom of the surface. Apply as a direct child of .modern-frame, sized by the consuming
   window. left/right/top default to the same 4dp inset as .modern-panel/.modern-frame-accent, not
   flush with .modern-frame's own edge (0/0) -- flush would paint over the frame's 2dp bevel
   border. A window can widen it back to 0/0 locally if it wants the header to reach the edge. */
.modern-header {
	position: absolute;
	left: 4dp;
	right: 4dp;
	top: 4dp;
	pointer-events: none;
	background-color: #131518;
	decorator: linear-gradient(to bottom, #1c2025 0%, #131518 45%, #0c0d0f 100%);
	border-bottom-width: 1dp;
	border-bottom-color: #000000;
}
/* Small round metal stud straddling the header's top edge, centered via width/height/margin-left
   (no transform needed). border-radius is a fixed dp value equal to half width/height, not 50% --
   this engine's border-radius only accepts a length (px/dp), not a percentage. */
.modern-header-rivet {
	position: absolute;
	left: 50%;
	top: -4dp;
	width: 8dp;
	height: 8dp;
	margin-left: -4dp;
	pointer-events: none;
	background-color: #0a0c0e;
	decorator: radial-gradient(circle, #4a5566 0%, #0a0c0e 75%);
	border: 1dp #373e49;
	border-radius: 4dp;
}
.modern-footer {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	pointer-events: none;
	border-top-width: 1dp;
	border-top-color: #1e2126;
}

/* Border-only recessed bevel, no fill -- for an element with legacy-drawn content underneath it
   (RmlUi always composites last, so any fill here would hide that content). */
.modern-inset {
	border-width: 1dp;
	border-top-color: rgba(0, 0, 0, 190); /* bevel-dark-inset */
	border-left-color: rgba(0, 0, 0, 190);
	border-bottom-color: rgba(255, 255, 255, 30); /* bevel-light-inset */
	border-right-color: rgba(255, 255, 255, 30);
}
.modern-inset.focused {
	border-top-color: token(accent-steel);
	border-left-color: rgba(107, 117, 132, 170); /* accent-steel's rgb @ 170 alpha */
}

/* Reusable "fading crimson banner" -- a soft ambient radial glow meant to sit behind a window's
   title text (warm-cream core cooling to a muted crimson ring, fading to transparent). Position/
   size stay the consuming window's own responsibility; place it as a sibling BEFORE the title
   text it sits behind (RmlUi paints earlier siblings first). */
.title-glow {
	position: absolute;
	pointer-events: none;
	decorator: radial-gradient(ellipse, rgba(163, 199, 237, 110), rgba(40, 65, 100, 130) 55%, transparent 88%);
}

/* Shared item-slot primitives -- generalized from main_frame.rcss's .slot-frame/.slot-fill/
   .selected so any future slot-based UI has a ready-made look. main_frame.rcss keeps its own
   class names (bound from C++/RML) but is retinted to match these exactly. */
.slot {
	border: 1dp token(border-frame);
	border-radius: token(radius-sm)dp;
}
.slot--filled {
	background-color: rgba(9, 10, 11, 150); /* dark backing, matches main_frame.rcss's existing .slot-fill convention -- not surface-control, that token is for a resting icon-button's light wash, the opposite direction */
}
.slot--selected {
	border-color: token(border-selected);
	background-color: rgba(50, 122, 198, 25); /* border-selected's rgb @ 25 alpha wash */
}

/* Shared editable-text primitive for stock RmlUi <input type="text"/"password"> -- the same tier as
   .btn/.checkbox-* above. Owns appearance only (typography, fill, border, states); every consumer
   supplies its own position/size through a local class, since no two fields share a box. Length
   limits and value validation stay in C++ (the owning window sets maxlength and decides what a
   valid value is) -- this layer only reflects the outcome, via .error below. */
.text-field {
	box-sizing: border-box;
	cursor: text;
	pointer-events: auto;
	text-align: left;
	color: token(text-primary);
	background-color: token(metal-dark);
	decorator: linear-gradient(to bottom, rgba(0, 0, 0, 140), rgba(0, 0, 0, 60));
	border: 1dp token(border-frame);
	border-radius: token(radius-sm)px;
	box-shadow: inset 0 1dp 3dp rgba(0, 0, 0, 200);
}
/* No :focus rule on purpose -- the native fields these replaced drew no focus outline, so the blinking
   caret stays the only focus cue. Add one per consumer if a screen ever wants it. */
/* Semantic state pushed from the model (data-class-error), never a colour set from C++. */
.text-field.error {
	border-color: token(semantic-danger);
	color: token(semantic-danger);
}
.text-field:disabled {
	pointer-events: none;
	color: token(text-disabled);
	background-color: token(surface-recessed);
	decorator: none;
}
/* RmlUi styles the selection range through the widget's own <selection> child element, which reads
   exactly these two properties (ElementTextSelection::OnPropertyChange). */
.text-field selection {
	color: token(metal-dark);
	background-color: token(accent-gold);
}

/* A label kept to one line in a constricted box -- see legacy/base.rcss's copy. */
.marquee { display: block; white-space: nowrap; overflow: hidden; }
.marquee.marquee-overflow { text-align: left; }

/* Scrolling content pane -- see legacy/base.rcss's copy for the two engine requirements baked in
   here (the `hidden auto` shorthand order, and why pointer-events must be opted back in). The
   container half is identical in both themes by design; only the scrollbar chrome below differs.

   The pane needs a bounded height to scroll within (explicit height, max-height, or a stretched
   flex child) -- the consumer's own layout, deliberately not set here. */
.scroll-pane {
	overflow: hidden auto;
	pointer-events: auto;
}

/* Flat rail in the metal-rail palette rather than the gold accent, tying the scrollbar to the
   header hardware -- where legacy uses native's real sprite art, this theme states the same
   affordance in its own language. */
.scroll-pane scrollbarvertical {
	width: 8dp;
	margin: 0;
}
.scroll-pane scrollbarvertical slidertrack {
	background-color: token(metal-rail-dark);
}
.scroll-pane scrollbarvertical sliderbar {
	background-color: token(metal-edge);
	border-radius: token(radius-sm)px;
}
.scroll-pane scrollbarvertical sliderbar:hover,
.scroll-pane scrollbarvertical sliderbar:active {
	background-color: token(metal-highlight);
}
/* Drag-only, matching legacy -- native has no arrow buttons on this scrollbar. */
.scroll-pane scrollbarvertical sliderarrowdec,
.scroll-pane scrollbarvertical sliderarrowinc {
	width: 0;
	height: 0;
}
.scroll-pane scrollbarhorizontal {
	height: 0;
}

.hidden {
	display: none;
}

/* Layout primitives -- identical to
   themes/legacy/base.rcss's copy; pure layout, nothing theme-specific to vary. */

/* Text drawn sharp inside a panel scaled by transform: scale(root_scale) -- see legacy base.rcss's
   copy for the full explanation. */
.sharp-text, .counter-scaled { transform: scale(calc(1 / var(--root-scale, 1))); }
/* Under a per-axis stretch (a Hud layout's #screen): it cancels --root-scale-y vertically. */
.counter-scaled-xy { transform: scale(calc(1 / var(--root-scale, 1)), calc(1 / var(--root-scale-y, 1))); }
.sharp-text { transform-origin: left top; }
.sharp-text.sharp-right { transform-origin: right top; }
/* A one-line layer centred on its box's height (a button's label): its middle sits on top: 50% at
   any panel scale. */
.sharp-text.sharp-middle { top: 50%; transform-origin: left center; transform: translateY(-50%) scale(calc(1 / var(--root-scale, 1))); }
.sharp-text.sharp-right.sharp-middle { transform-origin: right center; }
/* A layer centred on its parent's width (the parent is the box the theme sizes and places): wide
   enough that its text never overflows, which would start-align it, and scaled back around its
   centre, so the text stays centred on the box at any panel scale. */
.sharp-text.sharp-centre { left: 50%; width: 2000dp; margin-left: -1000dp; text-align: center; transform-origin: center top; }
.sharp-text.sharp-centre.sharp-middle { transform-origin: center center; }
/* Text that stacks: one counter-scaled layer whose lines flow inside it at the native size, so
   C++ hands out no tops. The theme sizes it in reference px through --flow-w (and --flow-h for
   .centred); everything inside is physical px. .centred centres the lines on the box's height,
   however many there are. */
.sharp-text.sharp-flow { width: calc(var(--flow-w, 0dp) * var(--root-scale, 1)); }
.sharp-text.sharp-flow.centred {
	height: calc(var(--flow-h, 0dp) * var(--root-scale, 1));
	display: flex;
	flex-direction: column;
	justify-content: center;
}

.anchor-top-left {
	position: absolute;
	left: 0;
	top: 0;
}
.anchor-top-right {
	position: absolute;
	right: 0;
	top: 0;
}
.anchor-bottom-left {
	position: absolute;
	left: 0;
	bottom: 0;
}
.anchor-bottom-right {
	position: absolute;
	right: 0;
	bottom: 0;
}

.center-x {
	position: absolute;
	left: 50%;
	transform: translateX(-50%);
}
.center-y {
	position: absolute;
	top: 50%;
	transform: translateY(-50%);
}
/* A press on a control never drags the window around it: RmlUi starts a drag from the nearest
   ancestor with `drag` set, and the control's click would still fire on release. */
input, select, textarea, .btn, [data-event-click] { drag: block; }
/* The original 640x480 screen, at a scale composed from the scale inputs (RmlScaleInputs.h): a
   .stage is centred on the window at the UI scale, as the original centred its NPC panels and
   dialogs; a .hud-board stands on the window's bottom, centred like the HUD, at the HUD's scale.
   Children lay out in its reference px, and --root-scale is its scale. */
.stage, .hud-board { position: absolute; left: 50%; width: 640dp; height: 480dp; margin-left: -320dp; }
.stage { top: 50%; margin-top: -240dp; transform-origin: center; transform: scale(var(--ui-scale));
         --root-scale: var(--ui-scale); }
.hud-board { bottom: 0; transform-origin: center bottom; transform: scale(var(--hud-scale));
             --root-scale: var(--hud-scale); }
/* MU Estudo: .stage.dp is the same 640x480 screen in dp, without the transform (tools/estudo_dp.py). The dp ratio
   is --ui-scale, so it lands in the same place, and its text is rasterized at the final size instead of being
   stretched (blurry at 8-9 px x 2 in 1920x1080). Its windows' sheets are in dp. */
.stage.dp { width: 640dp; height: 480dp; margin-left: -320dp; margin-top: -240dp; transform: none; --root-scale: 1; }
/* A panel a workspace slot places (CObject::GetPlacedDocument()): the slot's top-left and its
   region's scale arrive as variables; the theme decides how they apply. It takes the pointer, so
   clicks on it never reach the world or the windows below. */
#panel.slot-placed, #content_root.slot-placed {
	pointer-events: auto;
	transform-origin: left top;
	left: var(--slot-left);
	top: var(--slot-top);
	transform: scale(var(--root-scale));
}
/* A centred panel the player dragged: left/top place it (UI::RmlBridge::MakeDraggable()). */
.center-both.dragged { transform: none; }

.center-both {
	position: absolute;
	left: 50%;
	top: 50%;
	transform: translate(-50%, -50%);
}

.stretch-x {
	position: absolute;
	left: 0;
	right: 0;
}
.stretch-y {
	position: absolute;
	top: 0;
	bottom: 0;
}
.stretch-both {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

/* Invisible marker read by C++ via Element::GetAbsoluteOffset() -- see themes/legacy/base.rcss's
   identical comment for the full mechanism. */
.layout-anchor {
	position: absolute;
	visibility: hidden;
	width: 0;
	height: 0;
	pointer-events: none;
}

/* ============================================================================
   Forged-dialog construction
   ----------------------------------------------------------------------------
   Structural counterpart to the palette tokens above. Explicit RML layers +
   per-side bevel borders rather than box-shadow. The login dialog is the
   first consumer.
   ============================================================================ */

/* Exterior silhouette / asymmetric perimeter. Put this as the first child of a positioned
   .modern-frame; it creates the dark outer edge a browser would express with an outside
   pseudo-element/shadow. Transparent fill -- a solid fill here would read as a second opaque
   rectangle behind the window surface instead of a thin edge. Highlight alphas are boosted well
   past a literal browser conversion, which reads as invisible over a real 3D game scene. */
.modern-shell-edge {
	position: absolute;
	left: -3dp;
	right: -3dp;
	top: -3dp;
	bottom: -3dp;
	pointer-events: none;
	background-color: transparent;
	border-radius: token(radius-sm)dp;
	border-width: 1dp;
	border-color: rgba(25, 28, 32, 242);
	box-shadow:
		inset 1dp 0 0 rgba(94, 107, 127, 110),
		inset -1dp 0 0 rgba(0, 0, 0, 204),
		inset 0 1dp 0 rgba(106, 122, 146, 90),
		inset 0 -1dp 0 rgba(0, 0, 0, 230);
}

/* Inner groove, ~4dp inward -- counterpart to .modern-shell-edge above: a thin warm hairline
   catch plus a broad inward darkness, which is what sells the recessed/carved look. */
.modern-groove {
	position: absolute;
	left: 4dp;
	right: 4dp;
	top: 4dp;
	bottom: 4dp;
	pointer-events: none;
	border-width: 1dp;
	border-color: #1e2227;
	box-shadow:
		inset 0 0 0 1dp rgba(86, 99, 118, 40),
		inset 0 0 12dp rgba(0, 0, 0, 153);
}

/* Visible-width blackened-iron rail -- metal header with ONE center rivet (.modern-joint below),
   the alternative to .modern-title-plate's crimson hero-banner (never both on the same window).
   box-shadow's inset pair is the header's top catch-light/bottom seat; the outset pair is the
   cast shadow proving this rail sits above whatever's below it. */
.modern-header-rail {
	position: absolute;
	left: 8dp;
	right: 8dp;
	top: 7dp;
	height: 38dp;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(147, 179, 214, 13), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #131518 45%, token(metal-rail-dark));
	border-width: 1dp;
	border-color: token(border-rail);
	border-bottom-color: #121418;
	box-shadow:
		inset 0 1dp 0 rgba(194, 217, 242, 18),
		inset 0 -1dp 0 #000000,
		0 2dp 4dp rgba(0, 0, 0, 133);
}

/* Subtle horizontal warm accent line near the rail's bottom edge -- purely decorative, painted as
   the rail's last child so it sits on top of the rail's fill. */
.modern-header-accent {
	position: absolute;
	left: 7dp;
	right: 7dp;
	bottom: 2dp;
	height: 1dp;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#56657c 50%,
		token(metal-warm-edge) 70%,
		transparent);
}

/* Title text for .modern-header-rail. Vertically centered in the rail's 38dp height via
   top:50%/margin-top. Not used by Login (its header is the crimson hero-banner/
   .modern-title-plate, with the server name centered directly on the plate). */
.modern-header-text {
	position: absolute;
	left: 11dp;
	top: 50%;
	margin-top: -7dp;
	pointer-events: none;
}
/* Available for a future window that wants a small uppercase category label above the title --
   not consumed today. */
.modern-header-eyebrow {
	font-size: 7dp;
	color: #58616e;
	font-family: "token(font-body)";
}
.modern-header-title {
	color: token(text-warm);
	font-family: "token(font-title)";
	font-size: 13dp;
	font-weight: 500;
	letter-spacing: 0.2dp;
	font-effect: shadow(0dp 1dp #000000);
}

/* Recessed body plane. Content belongs inside this element in RML. The broad inset box-shadow is
   what sells "physically recessed behind the frame" -- a border-color bevel alone is too thin an
   effect for a cavity this size. */
.modern-content-well {
	position: absolute;
	pointer-events: none;
	background-color: token(surface-recessed);
	decorator: linear-gradient(to bottom, #0a0c0e, #070809);
	border-width: 1dp;
	border-color: token(border-inner);
	box-shadow:
		inset 0 0 16dp rgba(0, 0, 0, 166),
		inset 0 1dp 0 rgba(255, 255, 255, 5);
}

/* A structural container for the action row, not a second boxed panel -- no fill, no border, no
   visual identity of its own; still a real element since it needs to hold the buttons. */
.modern-footer-band {
	position: absolute;
	pointer-events: none;
}

/* Physical crimson title plate -- this IS the hero-banner header for whichever window uses it
   (Login among them); a window uses this OR the metal .modern-header-rail/.modern-joint pair,
   never both. box-shadow's inset pair is the plate's top highlight/bottom seat; outset is the
   cast shadow proving it sits on/in whatever's behind it. */
.modern-title-plate {
	position: absolute;
	pointer-events: none;
	background-color: token(metal-title-face);
	decorator:
		linear-gradient(to bottom, rgba(191, 222, 255, 18), transparent 34%),
		linear-gradient(to bottom, #1f2f45 0%, token(metal-title-face) 56%, token(metal-title-face-dark) 100%);
	border-width: 1dp;
	border-color: token(border-title);
	box-shadow:
		inset 0 1dp 0 rgba(177, 215, 255, 23),
		inset 0 -1dp 0 #040405,
		0 2dp 5dp rgba(0, 0, 0, 140);
}

/* Center-rivet stud for the METAL rail (.modern-header-rail, not .modern-title-plate) -- a real
   13x13 square rotated 45deg. Centered via left:50%/negative margin-left rather than
   `translateX(-50%) rotate(45deg)`, since combining calc()/translate with rotate in one
   declaration isn't verified on this engine. top:-8dp straddles the rail's top edge. */
.modern-joint {
	position: absolute;
	left: 50%;
	top: -8dp;
	width: 13dp;
	height: 13dp;
	margin-left: -6.5dp;
	pointer-events: none;
	background-color: token(metal-groove);
	border-width: 1dp;
	border-color: #373e49;
	transform: rotate(45deg);
	box-shadow: inset 0 0 0 2dp #0a0c0e;
}

/* ============================================================================
   Header-rail family -- px companions for root_scale-driven windows
   ----------------------------------------------------------------------------
   RmlUi's `dp` unit is multiplied by the CONTEXT's density-independent-pixel
   ratio (Source/Core/ComputeProperty.cpp: `case Unit::DP: return value.number *
   dp_ratio;`), which RmlUiRuntime.cpp's ApplyUIScale() sets once per context
   from UIScalePercent x ViewportFitScale(). `px` is never touched by that
   ratio. That's the right (and only) scaling mechanism for a STATIC dialog
   like Login/SysMenu, whose entire panel is authored in `dp` with no other
   scaling involved.

   A MOVABLE window synced to a native/legacy-positioned counterpart (e.g.
   MyInventory, tracking the native paperdoll) instead scales its whole #panel
   via a CSS `transform: scale(root_scale)`, where root_scale comes from
   UI::Scaling::GetActiveTransform() -- a completely different number from the
   context's dp_ratio. Since `transform: scale()` scales its entire subtree
   regardless of each descendant's own units, a `dp` length in such a panel
   gets BOTH factors compounded (dp_ratio at layout, then root_scale again via
   the transform) while a `px` length only gets root_scale -- so the two units
   drift apart and a borrowed `dp` primitive renders at the wrong size
   relative to that window's own `px`-based geometry.

   These are the same primitives as their `dp` counterparts above --
   same property values, same token() color/gradient references (still fully
   shared: a tokens.ini palette edit repaints both variants) -- with every
   length re-expressed in `px` instead. Use these (never the `dp` originals)
   inside any window whose #panel carries a `transform: scale(root_scale)`;
   use the `dp` originals everywhere else. Keep both variants' property lists
   identical when editing one. */
/* Box only -- NOT painted here. This context renders dead last in the frame, after native
   Render3D(), so a painted rail would cover any 3D item that overflows its cell upward; the real
   fill/border/shadow/accent live in each window's own `*_bg.rcss` as `.rail-fill`/`.rail-accent`
   instead. This box just gives `.modern-header-text-px`'s `top:50%` a rect to resolve against. */
.modern-header-rail-px {
	position: absolute;
	left: 8dp;
	right: 8dp;
	top: 7dp;
	height: 38dp;
	pointer-events: none;
}
.modern-header-text-px {
	position: absolute;
	left: 11dp;
	top: 50%;
	margin-top: -7dp;
	pointer-events: none;
}
.modern-header-eyebrow-px {
	font-size: 7dp;
	color: #58616e;
	font-family: "token(font-body)";
}
.modern-header-title-px {
	color: token(text-warm);
	font-family: "token(font-title)";
	font-size: 13dp;
	font-weight: 500;
	letter-spacing: 0.2dp;
	font-effect: shadow(0px 1px #000000);
}
.modern-joint-px {
	position: absolute;
	left: 50%;
	top: -8dp;
	width: 13dp;
	height: 13dp;
	margin-left: -6.5dp;
	pointer-events: none;
	background-color: token(metal-groove);
	border-width: 1dp;
	border-color: #373e49;
	transform: rotate(45deg);
	box-shadow: inset 0 0 0 2dp #0a0c0e;
}

/* ============================================================================
   Inventory-family window chrome -- px companions
   ----------------------------------------------------------------------------
   Generalized from my_inventory.rcss's .inv-btn/.inv-wallet family (first
   consumer: CMyInventory) for reuse by every other CInventoryCtrl-owning
   window (Trade, Storage, Storage Ext, Mix, NPC Shop, My/Purchase Shop,
   Inventory Extension, Lucky Item) -- they all show the same 37x26
   corner-button chrome and, except Storage Ext, the same gold-amount strip.
   `px` for the same reason as the header-rail family above: every one of
   these windows scales via its own `transform: scale(root_scale)`, not the
   RmlUi context's dp ratio.

   Position (left/top/width where given) is this family's own established
   default (CMyInventory's already-tuned values) -- override per-window only
   when that window's own layout genuinely differs, same convention as
   .modern-header-rail-px's top/height override in my_inventory.rcss. */
/* 9 above the panel's bottom: the original row's top 392 in a 429-tall panel, for the 28-tall box. */
.modern-icon-btn-px {
	position: absolute;
	bottom: 9dp;
	width: 37dp;
	height: 26dp;
	cursor: pointer;
	pointer-events: auto;
	text-align: center;
	line-height: 26dp;
	color: token(text-secondary);
	background-color: #0f1114;
	decorator:
		linear-gradient(to bottom, rgba(255, 255, 255, 11), transparent 40%),
		linear-gradient(to bottom, #1d2126, #101215 56%, #08090a);
	border: 1dp token(border-frame);
	border-radius: token(radius-sm)px;
	box-shadow:
		0 2dp 5dp rgba(0, 0, 0, 133),
		inset 0 1dp 0 rgba(192, 215, 240, 18),
		inset 0 -1dp 0 #000000;
}
.modern-icon-btn-px:hover {
	color: token(accent-gold-hover);
	border-color: token(border-hover);
	decorator:
		linear-gradient(to bottom, rgba(255, 255, 255, 15), transparent 40%),
		linear-gradient(to bottom, #21262e, #101317 56%, #090a0c);
}
.modern-icon-btn-px.hidden { display: none; }
.modern-icon-btn-px.locked { pointer-events: none; filter: brightness(0.6); }
.modern-icon-btn-glyph-px {
	/* No explicit color -- RmlUi inherits it from .modern-icon-btn-px by default already; this
	   build's CSS parser doesn't recognize the literal `inherit` keyword (logs a syntax-error
	   warning and drops the declaration, same net effect but noisy). */
	font-weight: bold;
	font-family: "DejaVu Sans";
	pointer-events: none;
}

/* px companions of .btn and .checkbox-box, for panels scaled by transform: scale(root_scale),
   where their dp sizes would be scaled twice. Same recipe and values, reference px; no size of
   their own -- each consumer boxes them. */
.modern-btn-px {
	position: absolute;
	text-align: center;
	cursor: pointer;
	color: #a6b0be;
	background-color: #0f1114;
	decorator: linear-gradient(to bottom, rgba(255, 255, 255, 10), transparent 45%),
		linear-gradient(to bottom, #1d2126, #0f1114 58%, #090a0b);
	border-width: 1dp;
	border-color: #383f4a;
	border-radius: token(radius-sm)px;
	box-sizing: border-box;
	pointer-events: auto;
	box-shadow:
		inset 0 1dp 0 rgba(192, 215, 240, 14),
		inset 0 -1dp 0 #000000,
		0 1dp 2dp rgba(0, 0, 0, 153);
}
.modern-btn-px:hover {
	color: #8ab7e7;
	border-color: #4e5b6f;
	decorator: linear-gradient(to bottom, rgba(255, 255, 255, 13), transparent 45%),
		linear-gradient(to bottom, #21262e, #101317 58%, #090a0c);
}
.modern-btn-px:active {
	box-shadow: inset 0 1dp 3dp rgba(0, 0, 0, 184);
}

.modern-checkbox-px {
	position: absolute;
	background-color: #0b0c0e;
	border-width: 1dp;
	border-color: #38414e;
	border-radius: token(radius-sm)px;
	box-sizing: border-box;
	box-shadow: inset 0 1dp 2dp rgba(0, 0, 0, 140);
}
.modern-checkbox-px.checked {
	background-color: #225e9d;
	decorator: linear-gradient(to bottom, #5e9adb, #225e9d);
	border-color: #3375bb;
}

/* Vector wallet bar (forged-metal strip + coin glyph + label), replacing every legacy money-bar
   sprite in this family. Default geometry matches CMyInventory's own 15/366/160/20 -- override
   left/top/width per-window if that window's layout doesn't share Inventory's 15-175px column. */
.modern-wallet-px {
	position: absolute;
	left: 15dp;
	top: 366dp;
	width: 160dp;
	height: 20dp;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(147, 179, 214, 9), transparent 34%),
		linear-gradient(to bottom, #101215, #08090a);
	border: 1dp token(border-rail);
	border-radius: token(radius-sm)px;
	box-shadow:
		inset 0 1dp 0 rgba(194, 217, 242, 12),
		inset 0 -1dp 0 #000000;
}
.modern-wallet-coin-px {
	position: absolute;
	left: 8dp;
	top: 50%;
	width: 12dp;
	height: 8dp;
	margin-top: -4dp;
	border: 1dp #8f6922;
	border-radius: 4dp;
	background-color: #8f6922;
	decorator: linear-gradient(to bottom, #d3aa4e, #8f6922);
}
.modern-wallet-label-px {
	position: absolute;
	left: 26dp;
	top: 50%;
	margin-top: -4dp;
	font-size: 7dp;
	letter-spacing: 0.06em;
	text-transform: uppercase;
	color: #667080;
	font-family: "token(font-body)";
}
/* Sibling of .modern-wallet-px, not nested in it -- same reasoning as my_inventory.rcss's
   original #gold_text (an independent absolutely-positioned element reads its own right-aligned
   value more simply than a child squeezed into the wallet bar's own box). */
.modern-wallet-value-px {
	position: absolute;
	right: 18dp;
	top: 371dp;
	width: 110dp;
	text-align: right;
	color: token(text-warm);
	font-weight: 500;
	font-size: 10dp;
	white-space: nowrap;
	pointer-events: none;
	font-effect: shadow(0px 1px #000000);
}

/* Recessed control cavity. background is flat (no decorator); depth comes primarily from the
   inset box-shadow. */
.modern-control-well {
	background-color: #08090a;
	border-width: 1dp;
	border-color: #2c3139;
	box-shadow:
		inset 0 2dp 7dp rgba(0, 0, 0, 191),
		inset 0 0 0 1dp rgba(78, 90, 109, 13);
}

/* Zen amounts by wealth tier (GameLogic::Items::GoldAmountTier; the model binds its key, the RML
   toggles .gold-<key>). The original client's colors. */
.gold-amount.gold-base             { color: #ffdc96; }
.gold-amount.gold-hundred-thousand { color: #00c918; }
.gold-amount.gold-million          { color: #ff9600; }
.gold-amount.gold-ten-million      { color: #ff0000; }

/* Level gauge: a recessed rail and a gold fill by level. .level-gauge-hit takes the pointer;
   consumers size and place all three. C++: UI::RmlBridge::ApplyLevelGaugeEvent(). */
.level-gauge {
	background-color: token(metal-rail-dark);
	border-width: 1dp;
	border-color: token(border-inner);
	border-radius: token(radius-sm)px;
	box-sizing: border-box;
	pointer-events: none;
}
.level-gauge-fill {
	position: absolute;
	background-color: token(accent-gold);
	decorator: linear-gradient(to bottom, token(accent-gold-hover), token(accent-gold));
	border-radius: token(radius-sm)px;
	pointer-events: none;
}
.level-gauge-hit { position: absolute; top: 0; bottom: 0; pointer-events: auto; drag: drag; cursor: pointer; }

/* A fill's level as a class (level-<n>); 10 steps, or 5 on an effect gauge. A consumer binding its
   own width (the MU Helper detail window) does not use these. */
.level-gauge-fill.level-1 { width: 10%; }
.level-gauge-fill.level-2 { width: 20%; }
.level-gauge-fill.level-3 { width: 30%; }
.level-gauge-fill.level-4 { width: 40%; }
.level-gauge-fill.level-5 { width: 50%; }
.level-gauge-fill.level-6 { width: 60%; }
.level-gauge-fill.level-7 { width: 70%; }
.level-gauge-fill.level-8 { width: 80%; }
.level-gauge-fill.level-9 { width: 90%; }
.level-gauge-fill.level-10 { width: 100%; }
.effect-gauge .level-gauge-fill.level-1 { width: 20%; }
.effect-gauge .level-gauge-fill.level-2 { width: 40%; }
.effect-gauge .level-gauge-fill.level-3 { width: 60%; }
.effect-gauge .level-gauge-fill.level-4 { width: 80%; }
.effect-gauge .level-gauge-fill.level-5 { width: 100%; }

/* The frame's corner close: an unstyled hit box over the close "X" the frame art draws at the
   panel's top-right (its circle spans about 166-182 x 4-20 of the original 190-wide panel), a
   little larger than the circle so it is easy to hit, and above the panel's other parts (a title
   bar that is also a drag handle). Each window's markup adds it with its own close event. */
#frame_corner_close {
	position: absolute;
	top: 1dp;
	right: 3dp;
	width: 24dp;
	height: 22dp;
	cursor: pointer;
	pointer-events: auto;
	z-index: 1;
}

/* ---- Obsidiana e prata: pecas do Meshy (tools/obsidiana_theme/gerar.py). Pecas em 4x, por isso resolution 4x:
   a borda da peca sai com o mesmo tamanho em dp que tem no cliente Godot. ---- */





.btn, .btn-icon, .btn-ok, .btn-icon-primary {
	background-color: transparent;
	decorator: ninepatch(ob-botao, ob-botao-in, 2);
	border-width: 0;
	box-shadow: none;
	color: token(text-primary);
}
.btn:hover, .btn-icon:hover, .btn-ok:hover, .btn-icon-primary:hover {
	decorator: ninepatch(ob-botao-sob, ob-botao-sob-in, 2);
	color: #ffffff;
	box-shadow: none;
}
.btn:active, .btn-icon:active {
	decorator: ninepatch(ob-botao-apertado, ob-botao-apertado-in, 2);
	box-shadow: none;
}
.btn.disabled, .btn-icon.disabled, .btn-ok.disabled {
	background-color: transparent;
	decorator: ninepatch(ob-botao-off, ob-botao-off-in, 2);
	border-width: 0;
	color: token(text-muted);
	opacity: 1;
}
.btn-icon-label, .btn-icon-primary .btn-icon-label { color: token(text-primary); }

.modern-frame, .modern-frame-crimson {
	background-color: transparent;
	decorator: ninepatch(ob-moldura, ob-moldura-in, 2);
	border-width: 0;
}
.modern-panel, .modern-panel-crimson {
	background-color: rgba(4, 6, 10, 150);
	decorator: none;
	border-width: 1dp;
	border-color: #1e2228;
	border-radius: 0;
}

/* moldura de prata por fora das janelas do modern (o anel -3dp que cada janela ja poe como primeiro filho) */
.modern-shell-edge {
	decorator: ninepatch(ob-moldura, ob-moldura-in, 2);
	border-width: 0;
	box-shadow: none;
}
.modern-groove { border-color: #1e2228; box-shadow: inset 0 0 12dp rgba(0, 0, 0, 153); }

/* placa do titulo: a barra da peca do Meshy (os losangos das pontas sao os do modern, recoloridos), no lugar da faixa carmim e do trilho de ferro */
.modern-title-plate, .modern-header-rail {
	background-color: transparent;
	decorator: ninepatch(ob-placa, ob-placa-in, 2);
	border-width: 0;
	box-shadow: none;
}
.modern-header-accent { visibility: hidden; }
.label-server, .modern-header-title { color: token(text-warm); font-family: "token(font-title)"; }

/* botoes em pixel do inventario, loja, bau e troca */
.modern-btn-px, .modern-icon-btn-px {
	background-color: transparent;
	decorator: ninepatch(ob-botao, ob-botao-in, 2);
	border-width: 0;
	box-shadow: none;
}
.modern-btn-px:hover, .modern-icon-btn-px:hover { decorator: ninepatch(ob-botao-sob, ob-botao-sob-in, 2); color: #ffffff; }
.modern-btn-px:active { decorator: ninepatch(ob-botao-apertado, ob-botao-apertado-in, 2); }

/* poco dos campos de texto (login e afins) */
.modern-control-well {
	background-color: transparent;
	decorator: ninepatch(ob-campo, ob-campo-in, 2);
	border-width: 0;
	box-shadow: none;
}

.text-field {
	background-color: transparent;
	decorator: ninepatch(ob-campo, ob-campo-in, 2);
	border-width: 0;
}
.text-field:focus { decorator: ninepatch(ob-campo-foco, ob-campo-foco-in, 2); }
/* janelas do estudo em dp (tools/estudo_dp.py): o ninepatch ja multiplica pelo dp ratio, a escala 2 deixa a borda como era no .stage esticado */
.stage.dp .text-field { decorator: ninepatch(ob-campo, ob-campo-in, 2); }
.stage.dp .text-field:focus { decorator: ninepatch(ob-campo-foco, ob-campo-foco-in, 2); }

/* ---- Obsidiana e prata, rodada 6: carteira do zen com a moeda do Tema 3 (inv_zen, 170 x 26). A peca leva arte do S6,
   entao vem da camada do estudo (estudo/, mumain_dream.py), fora do git; sem ela fica so a caixa. Presa no topo sem
   esticar: a carteira do bau tem duas linhas (zen e taxa). ---- */
.modern-wallet-px {
	height: 24dp;
	margin-top: -2dp;
	background-color: token(surface-recessed);
	decorator: image(estudo/inv_zen.tga contain left top);
	border-width: 0;
	box-shadow: none;
}
.modern-wallet-coin-px, .modern-wallet-label-px { display: none; }

/* o glifo de consertar (U+238B, inventario e loja) nao existe em nenhuma fonte do jogo e saia como um quadrado vazio:
   martelos desenhados (arte/ico_reparo e ico_reparo_tudo, gerar.py) no lugar */
.inv-btn-repair .modern-icon-btn-glyph-px, .shop-btn-repair .modern-icon-btn-glyph-px,
.shop-btn-repair-all .modern-icon-btn-glyph-px {
	display: block;
	position: absolute;
	left: 50%;
	top: 50%;
	width: 14dp;
	height: 14dp;
	margin-left: -7dp;
	margin-top: -7dp;
	color: transparent;
	font-size: 1dp;
	decorator: image(arte/ico_reparo.tga);
}
.shop-btn-repair-all .modern-icon-btn-glyph-px { width: 18dp; margin-left: -9dp; decorator: image(arte/ico_reparo_tudo.tga); }

/* Shared forged-dialog frame for the right-docked single-document window family:
   character_info, my_quest_info, pet_info, party_info -- all read as one visual family on screen
   (same right-hand docking slots), so their modern-theme chrome should match, not diverge by
   window. Link this BEFORE the window's own .rcss.

   Reuses base.rcss's already-shared .modern-shell-edge/.modern-groove/.modern-header-rail-px/
   .modern-joint-px/.modern-header-text-px/.modern-header-title-px/.modern-icon-btn-px directly
   (every consumer here already links base.rcss) rather than re-declaring them; each window's RML
   applies the shared classes directly. Only the PAINT that base.rcss's shared classes don't
   already cover (the #panel gradient/border/box-shadow body, and the header-rail's own
   fill/border/box-shadow + accent line) lives here -- these four windows share this one
   forged-dialog recipe so they render as one family. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190dp;
	height: 429dp;
	font-family: "token(font-body)";
	border-radius: token(radius-sm)px;
	background-color: #08090a;
	decorator: linear-gradient(to bottom, #0f1113 0%, #08090a 100%);
	border-width: 1dp;
	border-color: token(border-frame);
	box-shadow:
		0 11dp 30dp rgba(0, 0, 0, 158),
		0 2dp 5dp rgba(0, 0, 0, 217),
		inset 0 0 0 1dp #08090a,
		inset 0 0 0 3dp rgba(90, 102, 120, 190);
}

.frame-piece { display: none; }

/* Header-rail paint -- position comes from base.rcss's .modern-header-rail-px, applied alongside
   this class in the RML; each window's own class (e.g. .chainfo-header-rail) only needs to override
   top/height when it differs from this default (38dp tall, matching CMyInventory/CSysMenuWin). */
.docked-header-rail-fill {
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(147, 179, 214, 13), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #131518 45%, token(metal-rail-dark));
	border-width: 1dp;
	border-color: token(border-rail);
	border-bottom-color: #121418;
	box-shadow:
		inset 0 1dp 0 rgba(194, 217, 242, 18),
		inset 0 -1dp 0 #000000,
		0 2dp 4dp rgba(0, 0, 0, 133);
}
/* Nested inside .docked-header-rail-fill so left/right/bottom resolve against it. */
.docked-rail-accent {
	position: absolute;
	left: -1dp;
	right: -1dp;
	bottom: 2dp;
	height: 1dp;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#56657c 50%,
		token(metal-warm-edge) 70%,
		transparent);
}

/* A theme's data-fit="fill" slot sizes #panel (class fill-placement), its border included. */
#panel.fill-placement { box-sizing: border-box; }

/* Obsidiana e prata: pecas do Meshy (tools/obsidiana_theme/gerar.py) */
.docked-header-rail-fill { background-color: transparent; decorator: ninepatch(ob-placa, ob-placa-in, 2); border-width: 0; box-shadow: none; }

/* Modern theme for CCharacterInfoWindow -- same forged-dialog chrome recipe as CMyInventory
   (shell-edge/groove/gradient panel fill, rail-with-rivet header, bordered square icon buttons),
   not the generic .modern-frame/.modern-frame-crimson treatment: this window docks in the same
   right-dock row as CMyInventory/CMyQuestInfoWindow/CPetInfoWindow/CPartyInfoWindow and should
   read as the same family when open side by side. #panel/shell-edge/groove/header-rail chrome now
   all come from docked_panel_frame.rcss, shared with the other three -- only genuinely
   window-specific content stays here. */

/* Right-hand pieces are pinned to #panel's edges, so they follow a wider or filled panel. */

#name, #classname, #servername {
	position: absolute;
	left: 0;
	top: 12dp;
	width: 100%;
	text-align: center;
	font-weight: bold;
	font-size: 12dp;
	font-family: "token(font-body)";
	pointer-events: none;
	font-effect: shadow(0px 1px #000000);
}
#name { color: token(text-warm); }
#classname, #servername { top: 27dp; color: token(text-secondary); font-weight: normal; font-size: 11dp; }

.summary-fill {
	position: absolute;
	left: 12dp;
	right: 13dp;
	top: 48dp;
	height: 71dp;
	background-color: token(surface-panel);
	border-radius: token(radius-sm)dp;
	pointer-events: none;
}

/* 10dp, one line each: the longest lines (a level-400 EXP pair, the fruit counts) fit the 165dp
   summary box; the level-up points get a line of their own (beside the level they overlapped). */
.level-text, .levelup-point-text, .exp-text, .point-probability-text, .point-text {
	display: block;
	position: absolute;
	left: 18dp;
	font-size: 10dp;
	font-family: "token(font-body)";
	white-space: nowrap;
	pointer-events: none;
}
.level-text { top: 51dp; color: token(accent-gold-hover); font-weight: bold; }
.levelup-point-text { top: 63dp; color: token(accent-gold-hover); font-weight: bold; }
.exp-text { top: 76dp; color: token(text-primary); }
.point-probability-text { top: 89dp; color: token(accent-steel-hover); }
.point-text { top: 102dp; color: token(accent-steel-hover); }

.attr-textbox {
	position: absolute;
	left: 11dp;
	right: 9dp;
	height: 21dp;
	background-color: token(surface-control);
	border-radius: token(radius-sm)dp;
	pointer-events: none;
}
.attr-textbox-str { top: 120dp; }
/* AGI and VIT sit one line (13dp) below the original rows (175/240), so STR has room for its third line (the
   critical damage rate); VIT's room below takes the line back, so ENE and CMD keep their places. */
.attr-textbox-agi { top: 188dp; }
.attr-textbox-vit { top: 253dp; }
.attr-textbox-ene { top: 295dp; }
.attr-textbox-cmd { top: 350dp; }

.attr-label, .attr-value {
	display: block;
	position: absolute;
	text-align: center;
	font-weight: bold;
	font-size: 12dp;
	font-family: "token(font-body)";
	pointer-events: none;
}
.attr-label { left: 12dp; width: 74dp; color: token(text-secondary); }
.attr-value { left: 86dp; right: 18dp; color: rgb(0, 120, 248); }
.attr-label-str, .attr-value-str { top: 126dp; }
.attr-label-agi, .attr-value-agi { top: 194dp; }
.attr-label-vit, .attr-value-vit { top: 259dp; }
.attr-label-ene, .attr-value-ene { top: 301dp; }
.attr-label-cmd, .attr-value-cmd { top: 356dp; }

.attr-lines { position: absolute; width: 160dp; pointer-events: none; }
.attr-lines span { display: block; line-height: 13dp; font-size: 12dp; font-family: "token(font-body)"; white-space: nowrap; }
.attr-lines-str { left: 20dp; top: 145dp; }
.attr-lines-agi { left: 20dp; top: 212dp; }
.attr-lines-vit { left: 20dp; top: 277dp; }
.attr-lines-ene { left: 18dp; top: 319dp; }

/* Flat "+" button -- a generic affordance, kept simple rather than a full forged-metal square
   (too small at 16x15 to carry that much chrome); recolored to this window's own metal/border
   tokens instead of the generic accent-steel so it still reads as part of the same palette. */
.stat-btn {
	display: block;
	position: absolute;
	right: 14dp;
	width: 16dp;
	height: 15dp;
	background-color: token(metal-dark);
	border: 1dp token(border-frame);
	border-radius: token(radius-sm)dp;
	text-align: center;
	line-height: 13dp;
	font-weight: bold;
	font-size: 11dp;
	color: token(text-warm);
	cursor: pointer;
	pointer-events: auto;
}
.stat-btn:hover { color: token(accent-gold-hover); border-color: token(border-hover); }
/* data-class-hidden: base.rcss's .hidden has this rule's specificity and loses to its display. */
.stat-btn.hidden, .levelup-point-text.hidden, .attr-label.hidden, .attr-value.hidden { display: none; }
.stat-btn-str { top: 122dp; }
.stat-btn-agi { top: 190dp; }
.stat-btn-vit { top: 255dp; }
.stat-btn-ene { top: 297dp; }
.stat-btn-cmd { top: 352dp; }
/* The Rage Fighter's second Vitality line (melee damage) moves the Energy row down a line too; it has no
   Command row, so Energy keeps its room below. */
#panel.vitality-two-lines .attr-textbox-ene { top: 308dp; }
#panel.vitality-two-lines .attr-label-ene, #panel.vitality-two-lines .attr-value-ene { top: 314dp; }
#panel.vitality-two-lines .attr-lines-ene { top: 332dp; }
#panel.vitality-two-lines .stat-btn-ene { top: 310dp; }

/* Action row: base.rcss's .modern-icon-btn-px at its own default geometry (top:392/37x26) --
   same shared class CMyInventory's Exit/Repair/My Shop/Expand use, just this window's own left
   offsets and glyphs. */
.chainfo-btn-exit        { left: 13dp;  color: #8bb3dd; border-color: #2d4865; }
.chainfo-btn-quest       { left: 54dp; }
.chainfo-btn-pet         { left: 95dp; }
.chainfo-btn-masterlevel { left: 136dp; }

/* Outlaw level, from the model's pk_level -- the original's UI::Chat::SetPlayerColor() palette,
   which used to arrive as a colour string C++ built. #name's own colour is the fallback. */
#name.pk-0 { color: rgb(150, 255, 240); }
#name.pk-1 { color: rgb(100, 120, 255); }
#name.pk-2 { color: rgb(140, 180, 255); }
#name.pk-3 { color: rgb(200, 220, 255); }
#name.pk-4 { color: rgb(85, 167, 255); }
#name.pk-5 { color: rgb(255, 80, 30); }
#name.pk-6 { color: rgb(255, 0, 0); }

/* Where an attribute's total comes from, from the model's *_value_source. The original coloured
   the value for each of the three; the base colour lives on .attr-value above. */
.attr-value.attr-boosted { color: rgb(100, 150, 255); }
.attr-value.attr-potion  { color: rgb(20, 134, 255); }

.attr-lines span { color: token(text-primary); }
.attr-lines span.boosted { color: rgb(100, 150, 255); }
.attr-lines span.buffed { color: token(accent-gold); }
/* A line with a hint (the damage, the critical damage rate) shows it while the pointer is over it. */
.attr-lines span.hinted { pointer-events: auto; }

/* MuToDog: campo "Por clique" (quantos pontos cada + manda), a direita dos pontos livres. */
.stat-amount-label { position: absolute; right: 60dp; top: 63dp; color: token(text-primary); font-size: 10dp; white-space: nowrap; pointer-events: none; }
.stat-amount-field { position: absolute; right: 14dp; top: 61dp; width: 42dp; height: 15dp; font-size: 10dp; padding: 0 3dp; }
.stat-amount-label.hidden, .stat-amount-field.hidden { display: none; }

/* ---- Obsidiana e prata, rodada 6: janela do personagem no jeito do cliente Godot. Cada atributo numa caixa
   cha_caixa (placa de prata com o nome, recesso com o valor), + do Tema 3 (cha_mais, o quadro claro), resumo com filete de prata. ---- */

.summary-fill { background-color: #04060a; border: 1dp #788291; border-radius: 0; }
.attr-textbox { background-color: transparent; border-radius: 0; decorator: image(arte/cha_caixa.tga); }
.attr-label { left: 11dp; width: 72dp; color: #dae0ea; font-family: "token(font-title)"; }
.attr-value { color: #78bfff; }
.level-text, .levelup-point-text { color: #78bfff; }
.stat-btn {
	width: 16dp;
	height: 15dp;
	background-color: transparent;
	border-width: 0;
	decorator: image(ob-mais);
	color: transparent;
	font-size: 1dp;
}
.stat-btn:hover { color: transparent; opacity: 0.8; }
.chainfo-btn-exit { color: #e9edf3; border-color: #3e4652; }

#panel, #panel.slot-placed { transform: none; }
