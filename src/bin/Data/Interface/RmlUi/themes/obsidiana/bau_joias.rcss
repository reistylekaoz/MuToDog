/* MuToDog (MU Estudo, rodada 16): Baú de joias (bau_joias.rml), no jeito do cliente Godot (janela_bau_joias.gd): janela
   de 300 x 340 à esquerda da mochila (guardar é Ctrl + botão direito nela). Px da tela de referência 640 x 480
   (.stage). Os sprites das joias (item-<grupo>-<numero>) são escritos por tools/obsidiana_theme/icones_itens.py entre
   as marcas abaixo. */
/* sprites */
@spritesheet itens-bau
{
	src: "../modern/itens/todos.tga";
	item-12-15: 608dp 480dp 32dp 32dp;
	item-14-13: 704dp 704dp 32dp 32dp;
	item-14-14: 736dp 704dp 32dp 32dp;
	item-14-16: 800dp 704dp 32dp 32dp;
	item-14-22: 992dp 704dp 32dp 32dp;
	item-14-31: 224dp 736dp 32dp 32dp;
	item-14-41: 544dp 736dp 32dp 32dp;
	item-14-42: 576dp 736dp 32dp 32dp;
	item-14-43: 608dp 736dp 32dp 32dp;
	item-14-44: 640dp 736dp 32dp 32dp;
	item-14-151: 832dp 832dp 32dp 32dp;
	item-14-152: 864dp 832dp 32dp 32dp;
	item-14-153: 896dp 832dp 32dp 32dp;
	item-14-156: 992dp 832dp 32dp 32dp;
	item-14-157: 0dp 864dp 32dp 32dp;
	item-255-255: 256dp 896dp 32dp 32dp;
}
/* fim dos sprites */
body { pointer-events: none; }
#screen { pointer-events: none; }

#panel {
	position: absolute;
	left: 140dp;
	top: 60dp;
	width: 300dp;
	height: 340dp;
	background-color: rgba(9, 11, 13, 240);
	border: 1dp #3e4652;
	pointer-events: auto;
	font-family: "token(font-body)";
	color: #ebedf1;
}
#title {
	position: absolute;
	left: 0dp;
	top: 6dp;
	width: 300dp;
	height: 16dp;
	text-align: center;
	font-family: "token(font-title)";
	font-size: 12dp;
	line-height: 16dp;
	color: #dde1e7;
}
#rule { position: absolute; left: 8dp; top: 26dp; width: 284dp; height: 1dp; background-color: #3e4652; }
#saldo, #retirar, #escolher, #separar { position: absolute; left: 0dp; top: 0dp; width: 300dp; height: 340dp; }

.art { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; }
#rows { position: absolute; left: 10dp; top: 32dp; width: 280dp; height: 234dp; border: 1dp #262b33; }
#bag { position: absolute; left: 10dp; top: 48dp; width: 280dp; height: 218dp; border: 1dp #262b33; }

.row { display: block; position: relative; height: 22dp; border-bottom: 1dp #171a1f; }
.row .art { left: 2dp; top: 1dp; width: 20dp; height: 20dp; }
.row .name { position: absolute; left: 26dp; top: 0dp; width: 110dp; font-size: 8dp; line-height: 22dp; color: #ebedf1; white-space: nowrap; overflow: hidden; }
.row .qty { position: absolute; left: 138dp; top: 0dp; width: 82dp; text-align: right; font-size: 9dp; line-height: 22dp; color: #a9d3ff; white-space: nowrap; overflow: hidden; }
.row .qty.zero { color: #5a6575; }
.row .act {
	position: absolute;
	left: 226dp;
	top: 3dp;
	width: 44dp;
	height: 15dp;
	text-align: center;
	font-size: 8dp;
	line-height: 15dp;
	background-color: #1e2228;
	border: 1dp #3e4652;
	cursor: pointer;
	color: #bac1cc;
}
.row .act:hover { border-color: #78bfff; color: #ffffff; }
.row .site { position: absolute; left: 222dp; top: 0dp; width: 52dp; text-align: center; font-size: 7dp; line-height: 22dp; color: #7a8699; }
.row.pick { cursor: pointer; }
.row.pick:hover { background-color: rgba(120, 191, 255, 30); }
.none { display: block; padding: 6dp; font-size: 8dp; line-height: 11dp; color: #7a8699; }

.step { position: absolute; left: 10dp; top: 32dp; width: 280dp; font-size: 9dp; line-height: 12dp; color: #a9d3ff; }
.picked { position: absolute; left: 10dp; top: 48dp; width: 280dp; height: 30dp; }
.picked .box { position: absolute; left: 0dp; top: 0dp; width: 28dp; height: 28dp; background-color: #0e1116; border: 1dp #3e4652; border-radius: 4dp; }
.picked .label { position: absolute; left: 36dp; top: 0dp; width: 244dp; font-size: 9dp; line-height: 30dp; color: #ebedf1; white-space: nowrap; overflow: hidden; }
#qty_field { position: absolute; left: 10dp; top: 92dp; width: 150dp; height: 22dp; padding: 3dp 6dp; font-size: 11dp; line-height: 14dp; }
.help { position: absolute; left: 10dp; top: 124dp; width: 280dp; font-size: 8dp; line-height: 11dp; color: #7a8699; }

.button {
	position: absolute;
	top: 274dp;
	height: 18dp;
	text-align: center;
	font-size: 9dp;
	line-height: 18dp;
	background-color: #1e2228;
	border: 1dp #3e4652;
	cursor: pointer;
	color: #bac1cc;
}
.button:hover { border-color: #78bfff; color: #ffffff; }
.button.main { color: #ffffff; border-color: #78bfff; background-color: #14243a; }
#group { left: 10dp; width: 86dp; }
#split_open { left: 102dp; width: 104dp; }
#close { left: 212dp; width: 78dp; }
#back1, #back2, #back3 { left: 212dp; width: 78dp; }
#withdraw, #split { left: 10dp; width: 120dp; }

#note { position: absolute; left: 10dp; top: 296dp; width: 280dp; text-align: center; font-size: 8dp; line-height: 11dp; color: #78e678; }
#hint { position: absolute; left: 10dp; top: 312dp; width: 280dp; text-align: center; font-size: 8dp; line-height: 11dp; color: #7a8699; }
