/* MuToDog (MU Estudo, rodada 11): Horário dos eventos (eventos.rml), no jeito do cliente Godot (janela_eventos.gd):
   janela de 436 x 329 no meio da tela, cartões de 204 x 124 (2 x 2). Px da tela de referência 640 x 480 (.stage). A arte
   sai de tools/obsidiana_theme/icones_r11.py; o obsidiana põe o Meshy por cima (tools/obsidiana_theme/eventos.rcss). */
@spritesheet eventos-artes
{
	src: "../modern/eventos/folha.tga";
	ev-bc: 0dp 0dp 320dp 118dp;
	ev-ds: 320dp 0dp 320dp 118dp;
	ev-cc: 640dp 0dp 320dp 118dp;
	ev-hh: 0dp 118dp 320dp 118dp;
	ev-dourado: 320dp 118dp 320dp 118dp;
	ev-dragao: 640dp 118dp 320dp 118dp;
	ev-mago: 0dp 236dp 320dp 118dp;
	ev-kanturu: 320dp 236dp 320dp 118dp;
	ev-goblins: 640dp 236dp 320dp 118dp;
}
body { pointer-events: none; }
#screen { pointer-events: none; }

#panel {
	position: absolute;
	left: 102dp;
	top: 75dp;
	width: 436dp;
	height: 329dp;
	background-color: rgba(9, 11, 13, 245);
	border: 1dp #3e4652;
	pointer-events: auto;
	font-family: "token(font-body)";
	color: #ebedf1;
}
#title {
	position: absolute;
	left: 0dp;
	top: 4dp;
	width: 436dp;
	height: 16dp;
	text-align: center;
	font-family: "token(font-title)";
	font-size: 12dp;
	line-height: 16dp;
	color: #dde1e7;
}
#clock { position: absolute; left: 10dp; top: 24dp; width: 416dp; font-size: 9dp; line-height: 12dp; color: #7fb5ee; }
#status { position: absolute; left: 10dp; top: 49dp; width: 416dp; font-size: 9dp; line-height: 12dp; color: #8a94a4; }

.card {
	position: absolute;
	width: 204dp;
	height: 124dp;
	background-color: #090b0f;
	border: 1dp #3e4652;
}
.card0 { left: 10dp; top: 39dp; }
.card1 { left: 222dp; top: 39dp; }
.card2 { left: 10dp; top: 171dp; }
.card3 { left: 222dp; top: 171dp; }
.card.open { border-color: #28aa50; }
.card:hover { border-color: #78bfff; }
.art { position: absolute; left: 1dp; top: 1dp; width: 200dp; height: 74dp; opacity: 0.82; }
.card.open .art, .card:hover .art { opacity: 1; }
.band { position: absolute; left: 1dp; top: 53dp; width: 200dp; height: 22dp; decorator: linear-gradient(to bottom, #00000000 0%, #000000d0 100%); }
.name { position: absolute; left: 7dp; top: 60dp; width: 140dp; font-size: 10dp; line-height: 13dp; font-weight: bold; color: #ffffff; font-effect: shadow(1px 1px #000000); white-space: nowrap; }
.badge { position: absolute; left: 143dp; top: 5dp; width: 54dp; height: 13dp; background-color: #147832e6; text-align: center; font-size: 8dp; line-height: 13dp; font-weight: bold; color: #ffffff; }
.watch { position: absolute; left: 5dp; top: 81dp; width: 7dp; height: 7dp; border: 1dp #76b8ff; border-radius: 5dp; }
.hand { position: absolute; left: 3dp; top: 1dp; width: 1dp; height: 3dp; background-color: #76b8ff; }
.count { position: absolute; left: 17dp; top: 79dp; width: 120dp; font-size: 9dp; line-height: 12dp; font-weight: bold; color: #76b8ff; white-space: nowrap; }
.card.open .count { color: #78eb8c; }
.card.open .watch { border-color: #78eb8c; }
.card.open .hand { background-color: #78eb8c; }
.next { position: absolute; left: 130dp; top: 80dp; width: 68dp; text-align: right; font-size: 8dp; line-height: 11dp; color: #a6aebb; white-space: nowrap; }
.lock { position: absolute; left: 5dp; top: 96dp; width: 8dp; height: 10dp; }
.shackle { position: absolute; left: 1dp; top: 0dp; width: 4dp; height: 4dp; border: 1dp #6e7989; border-bottom-width: 0dp; border-radius: 3dp 3dp 0dp 0dp; }
.body { position: absolute; left: 0dp; top: 4dp; width: 8dp; height: 6dp; background-color: #6e7989; }
.lock.enter .shackle { border-color: #62a5ec; }
.lock.enter .body { background-color: #62a5ec; }
.level { position: absolute; left: 17dp; top: 95dp; width: 76dp; font-size: 8dp; line-height: 11dp; color: #8a94a4; white-space: nowrap; }
.level.enter { color: #ffffff; }
.about { position: absolute; left: 92dp; top: 95dp; width: 108dp; font-size: 7dp; line-height: 9dp; color: #a6aebb; }

#prev, #next, #close {
	position: absolute;
	top: 303dp;
	height: 16dp;
	text-align: center;
	font-size: 9dp;
	line-height: 16dp;
	background-color: #1e2228;
	border: 1dp #3e4652;
	cursor: pointer;
	color: #ffffff;
}
#prev:hover, #next:hover, #close:hover { border-color: #78bfff; }
#prev.disabled, #next.disabled { color: #48515e; cursor: default; }
#prev.disabled:hover, #next.disabled:hover { border-color: #3e4652; }
#prev { left: 10dp; width: 24dp; }
#next { left: 140dp; width: 24dp; }
#close { left: 366dp; width: 60dp; }
#page { position: absolute; left: 40dp; top: 305dp; width: 96dp; font-size: 9dp; line-height: 12dp; color: #a6aebb; }

/* ---- Obsidiana e prata, rodada 11: Horário dos eventos com a moldura, a placa do título e os botões do Meshy (base.rcss) ---- */
#panel { background-color: transparent; decorator: ninepatch(ob-moldura, ob-moldura-in, 2); border-width: 0; }
#title { left: 128dp; top: 3dp; width: 180dp; height: 18dp; line-height: 18dp; decorator: ninepatch(ob-placa, ob-placa-in, 2); }
#prev, #next, #close { background-color: transparent; decorator: ninepatch(ob-botao, ob-botao-in, 2); border-width: 0; }
#prev:hover, #next:hover, #close:hover { decorator: ninepatch(ob-botao-sob, ob-botao-sob-in, 2); }
#prev.disabled, #prev.disabled:hover, #next.disabled, #next.disabled:hover { decorator: ninepatch(ob-botao-off, ob-botao-off-in, 2); }
/* as cores da contagem e do cadeado ficam as do Godot (amarelo pra abrir, verde aberto, dourado entra) */
#clock { color: #e8c96a; }
.count { color: #ffd25a; }
.watch { border-color: #ffd25a; }
.hand { background-color: #ffd25a; }
.lock.enter .shackle { border-color: #e6b950; }
.lock.enter .body { background-color: #e6b950; }
.card.open .count { color: #78eb8c; }
.card.open .watch { border-color: #78eb8c; }
.card.open .hand { background-color: #78eb8c; }
