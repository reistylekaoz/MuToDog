/* MuToDog (MU Estudo, rodada 11): Log de caça (log_caca.rml), no jeito do cliente Godot (log_caca.gd): painel de 172 de
   largura no canto de cima à direita (464, 34; v1.0.2: letra 9 e linha 13, era 8 e 10), a altura vem das linhas. Px da tela de referência 640 x 480 (.stage). */
body { pointer-events: none; }
#screen { pointer-events: none; }

#panel {
	position: absolute;
	left: 464dp;
	top: 34dp;
	width: 172dp;
	padding-bottom: 24dp;
	background-color: rgba(19, 21, 25, 240);
	pointer-events: auto;
	drag: drag;
	cursor: move;
	font-family: "token(font-body)";
	color: #ebedf1;
	border: 1dp #3e4652;
	box-sizing: border-box;
}
#title {
	display: block;
	height: 16dp;
	margin: 1dp 1dp 6dp 1dp;
	background-color: rgba(120, 191, 255, 41);
	text-align: center;
	font-family: "token(font-title)";
	font-size: 10dp;
	line-height: 16dp;
	color: #dde1e7;
}
.row { display: block; position: relative; height: 13dp; margin: 0dp 8dp; font-size: 9dp; line-height: 13dp; white-space: nowrap; }
.row.vao { height: 6dp; }
.row .label { color: #a3abb8; }
.row .value { position: absolute; right: 0dp; top: 0dp; color: #f4f6f9; }
.row.titulo { border-top: 1dp rgba(62, 70, 82, 128); }
.row.titulo .label { font-weight: bold; color: #aad6ff; }
#reset {
	position: absolute;
	right: 8dp;
	bottom: 5dp;
	width: 48dp;
	height: 14dp;
	background-color: rgba(120, 191, 255, 46);
	text-align: center;
	font-size: 9dp;
	line-height: 14dp;
	color: #aad6ff;
	cursor: pointer;
}
#reset:hover { color: #ffffff; }
