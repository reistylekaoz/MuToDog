/* MuToDog (MU Estudo): Reset System e Grand Reset System (reset_system.rml), no jeito do cliente Godot
   (janela_reset.gd): janela de 230 x 252 no meio da tela e os icones da barra (agenda e reset) na HUD dream.
   Px da tela de referencia 640 x 480 (.stage e .hud-board). O obsidiana poe o Meshy por cima
   (tools/obsidiana_theme/reset_system.rcss). */
body { pointer-events: none; }
#screen, #board, #bar_icons { pointer-events: none; }

/* icones da barra: reset em x 405 e agenda em x 422, y 423,5, 14 x 14 (hud_mu.gd rect_botao 4 e 5) */
#icon_agenda, #icon_reset { position: absolute; top: 423.5px; width: 14px; height: 14px; }
#icon_agenda { left: 422px; }
#icon_reset { left: 405px; pointer-events: auto; cursor: pointer; opacity: 0.8; }
#icon_reset:hover, #icon_reset.ready, #icon_reset.ready-grand { opacity: 1; }
.hud-icon { position: absolute; left: 0px; top: 0px; width: 14px; height: 14px; }
#icon_reset:hover .hud-icon { left: -1px; top: -1px; width: 16px; height: 16px; }
#icon_glow {
	display: none;
	position: absolute;
	left: -3px;
	top: -3px;
	width: 20px;
	height: 20px;
	border-radius: 10px;
	background-color: rgba(118, 184, 255, 110);
	animation: 0.6s quadratic-in-out infinite alternate reset-pulso;
}
#icon_reset.ready #icon_glow { display: block; }
#icon_reset.ready-grand #icon_glow { display: block; background-color: rgba(200, 150, 255, 110); }
@keyframes reset-pulso {
	from { opacity: 0.35; }
	to { opacity: 1; }
}

#panel {
	position: absolute;
	left: 205px;
	top: 114px;
	width: 230px;
	height: 252px;
	background-color: rgba(9, 11, 13, 240);
	border: 1px #3e4652;
	pointer-events: auto;
	font-family: "token(font-body)";
	color: #ebedf1;
}
#title {
	position: absolute;
	left: 0px;
	top: 6px;
	width: 230px;
	text-align: center;
	font-family: "token(font-title)";
	font-size: 12px;
	line-height: 16px;
	color: #dde1e7;
}
#tabs { position: absolute; left: 12px; top: 30px; width: 218px; height: 20px; }
.tab {
	float: left;
	width: 100px;
	height: 18px;
	margin-right: 6px;
	text-align: center;
	font-size: 9px;
	line-height: 18px;
	background-color: #1e2228;
	border: 1px #3e4652;
	border-bottom: 2px #1e2228;
	cursor: pointer;
	color: #bac1cc;
}
.tab:hover { color: #ffffff; }
.tab.selected { border-bottom: 2px #78bfff; color: #ffffff; }
#head { position: absolute; left: 14px; top: 58px; width: 202px; height: 28px; }
#head_text { position: absolute; left: 0px; top: 6px; font-size: 12px; line-height: 14px; color: #ffffff; }
#head_icon, #head_icon_grand { position: absolute; right: 2px; top: 0px; width: 28px; height: 28px; }
#message {
	position: absolute;
	left: 14px;
	top: 96px;
	width: 202px;
	text-align: center;
	font-size: 9px;
	line-height: 14px;
	color: #78bfff;
}
#rows { position: absolute; left: 14px; top: 88px; width: 202px; }
.row { display: block; position: relative; height: 12px; font-size: 9px; line-height: 12px; }
.row .label { position: absolute; left: 8px; color: #bac1cc; }
.row .value { position: absolute; right: 8px; text-align: right; }
.row.secao { height: 16px; line-height: 16px; margin-top: 2px; border-bottom: 1px #3e4652; margin-bottom: 2px; }
.row.secao .label { left: 0px; font-family: "token(font-title)"; font-size: 10px; color: #dde1e7; }
.row.ok .value { color: #78e678; }
.row.falta .value { color: #ff6e5a; }
.row.premio .value { color: #bfe0ff; }
#note {
	display: block;
	position: relative;
	margin-top: 3px;
	width: 202px;
	text-align: center;
	font-size: 8px;
	line-height: 10px;
	color: #7a8699;
}
#do, #close {
	position: absolute;
	text-align: center;
	background-color: #1e2228;
	border: 1px #3e4652;
	cursor: pointer;
}
#do { left: 60px; top: 202px; width: 110px; height: 20px; font-size: 10px; line-height: 20px; color: #ffffff; }
#do:hover { border-color: #78bfff; }
#do.disabled { color: #48515e; cursor: default; }
#do.disabled:hover { border-color: #3e4652; }
#close { left: 85px; top: 226px; width: 60px; height: 18px; font-size: 9px; line-height: 18px; }
#close:hover { border-color: #78bfff; color: #ffffff; }

/* ---- Obsidiana e prata, rodada 7: Reset System com a moldura, a placa do titulo e os botoes do Meshy (base.rcss) ---- */
#panel { background-color: transparent; decorator: ninepatch(ob-moldura, ob-moldura-in, 1); border-width: 0; }
#title { left: 35px; top: 4px; width: 160px; height: 18px; line-height: 18px; decorator: ninepatch(ob-placa, ob-placa-in, 1); }
#do, #close, .tab { background-color: transparent; decorator: ninepatch(ob-botao, ob-botao-in, 1); border-width: 0; }
#do:hover, #close:hover, .tab:hover { decorator: ninepatch(ob-botao-sob, ob-botao-sob-in, 1); }
.tab.selected { decorator: ninepatch(ob-botao-apertado, ob-botao-apertado-in, 1); border-bottom: 2px #78bfff; }
#do.disabled, #do.disabled:hover { decorator: ninepatch(ob-botao-off, ob-botao-off-in, 1); }
