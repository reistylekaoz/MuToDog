/* Modern theme for CStorageInventoryExt's chrome -- header/exit-button are vector forged-metal
   chrome (matching Login/SysMenu/MyInventory's forged-dialog language). Inventory grid stays fully
   native (sprite art + live 3D icons), same as legacy -- no RmlUi involvement there. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* top:6/height:29 (not MyInventory's 7/36) -- this window's native grid starts at `m_Pos.y + 36`
   (StorageInventoryExt.cpp), a tighter budget than MyInventory's 44px. Ends at 35px, 1px clear.
   top:6 (not lower) keeps .modern-joint-px's rivet at -2px, still inside the frame's
   .inv-shell-edge at -3px -- same contained relationship as MyInventory/SysMenu.

   Named `.storext-*` (not `.ext-*`) -- inventory_extension.rcss independently picked the same
   "ext-" shorthand for its own, unrelated header-rail/exit-button classes; harmless today since
   the two documents never coexist, but a latent copy-paste trap if that ever changes. */
.storext-header-rail {
	top: 6px;
	height: 29px;
}

/* Single exit button, centered: (190-37)/2. */
.storext-btn-exit {
	left: 77px;
	color: #8bb3dd;
	border-color: #2d4865;
}

/* Native item grid: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid, #item_grid_counts { left: 15px; top: 36px; width: calc(8 * var(--item-cell)); height: calc(15 * var(--item-cell)); }

/* The frame. */
.bg-panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 190px;
	height: 429px;
	pointer-events: none;
	border-radius: token(radius-sm)px;
	background-color: #08090a;
	decorator: linear-gradient(to bottom, #0f1113 0%, #08090a 100%);
	border-width: 1px;
	border-color: token(border-frame);
	box-shadow:
		0 11px 30px rgba(0, 0, 0, 158),
		0 2px 5px rgba(0, 0, 0, 217),
		inset 0 0 0 1px #08090a,
		inset 0 0 0 3px rgba(90, 102, 120, 190);
}

.inv-shell-edge {
	position: absolute;
	left: -3px;
	right: -3px;
	top: -3px;
	bottom: -3px;
	pointer-events: none;
	background-color: transparent;
	border-radius: token(radius-sm)px;
	border-width: 1px;
	border-color: rgba(25, 28, 32, 242);
	box-shadow:
		inset 1px 0 0 rgba(94, 107, 127, 110),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(106, 122, 146, 90),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}

.inv-groove {
	position: absolute;
	left: 4px;
	right: 4px;
	top: 4px;
	bottom: 4px;
	pointer-events: none;
	border-width: 1px;
	border-color: #1e2227;
	box-shadow:
		inset 0 0 0 1px rgba(86, 99, 118, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}

/* Rail fill/accent relocated from the fg's now paint-less .modern-header-rail-px -- see
   base.rcss's comment on that class. top/height match .storext-header-rail (storage_ext.rcss). */
.rail-fill {
	position: absolute;
	left: 8px;
	right: 8px;
	top: 6px;
	height: 29px;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(147, 179, 214, 13), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #131518 45%, token(metal-rail-dark));
	border-width: 1px;
	border-color: token(border-rail);
	border-bottom-color: #121418;
	box-shadow:
		inset 0 1px 0 rgba(194, 217, 242, 18),
		inset 0 -1px 0 #000000,
		0 2px 4px rgba(0, 0, 0, 133);
}
/* Nested inside .rail-fill -- its left/right/bottom resolve against that box. */
.rail-accent {
	position: absolute;
	left: 7px;
	right: 7px;
	bottom: 2px;
	height: 1px;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#56657c 50%,
		token(metal-warm-edge) 70%,
		transparent);
}

/* The grid's clicks are native (CInventoryCtrl), so the placed panel takes no pointer events; its
   controls take their own. */
#panel.slot-placed { pointer-events: none; }

/* Obsidiana e prata: pecas do Meshy (tools/obsidiana_theme/gerar.py) */
.inv-shell-edge { decorator: ninepatch(ob-moldura, ob-moldura-in, 1); border-width: 0; box-shadow: none; }
.rail-fill { background-color: transparent; decorator: ninepatch(ob-placa, ob-placa-in, 1); border-width: 0; box-shadow: none; }
