	item-15-11: 560px 1080px 40px 40px;
	item-15-12: 600px 1080px 40px 40px;
	item-15-13: 640px 1080px 40px 40px;
	item-15-14: 680px 1080px 40px 40px;
	item-15-15: 720px 1080px 40px 40px;
	item-15-16: 760px 1080px 40px 40px;
	item-15-17: 800px 1080px 40px 40px;
	item-15-18: 840px 1080px 40px 40px;
	item-15-19: 880px 1080px 40px 40px;
	item-15-20: 920px 1080px 40px 40px;
	item-15-21: 960px 1080px 40px 40px;
	item-15-22: 1000px 1080px 40px 40px;
	item-15-23: 1040px 1080px 40px 40px;
