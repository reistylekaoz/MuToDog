}
/* fim dos sprites */
body { pointer-events: none; }
#screen { pointer-events: none; }

#panel {
	position: absolute;
	left: 170px;
	top: 60px;
	width: 300px;
	height: 340px;
	background-color: rgba(8, 10, 14, 240);
	border: 1px #3e4652;
	pointer-events: auto;
	color: #e9edf3;
}
#title {
	position: absolute;
	left: 0px;
	top: 6px;
	width: 300px;
	height: 16px;
	text-align: center;
	font-size: 12px;
	line-height: 16px;
	color: #dae0ea;
}
#rule { position: absolute; left: 8px; top: 26px; width: 284px; height: 1px; background-color: #3e4652; }
#lista, #escolher, #moeda, #preco { position: absolute; left: 0px; top: 0px; width: 300px; height: 340px; }

.art { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; }
.section { position: absolute; left: 10px; width: 280px; font-size: 9px; line-height: 12px; color: #ffe08a; }
#deliv_title { top: 32px; }
#offers_title { top: 120px; }
#deliv { position: absolute; left: 10px; top: 46px; width: 280px; height: 68px; border: 1px #262b33; }
#offers { position: absolute; left: 10px; top: 134px; width: 280px; height: 132px; border: 1px #262b33; }
#bag { position: absolute; left: 10px; top: 48px; width: 280px; height: 218px; border: 1px #262b33; }

.row { display: block; position: relative; height: 22px; border-bottom: 1px #161a20; }
.row .art { left: 2px; top: 1px; width: 20px; height: 20px; }
.row .name { position: absolute; left: 26px; top: 0px; width: 118px; font-size: 8px; line-height: 22px; color: #e9edf3; white-space: nowrap; overflow: hidden; }
.row .name.wide { width: 240px; }
.row .info { position: absolute; left: 146px; top: 0px; width: 76px; text-align: right; font-size: 8px; line-height: 22px; color: #7d8796; white-space: nowrap; overflow: hidden; }
.row .info.good { color: #78e678; }
.row .info.price { color: #ffe08a; }
.row .act {
	position: absolute;
	left: 226px;
	top: 3px;
	width: 44px;
	height: 15px;
	text-align: center;
	font-size: 8px;
	line-height: 15px;
	background-color: #1e2228;
	border: 1px #3e4652;
	cursor: pointer;
	color: #b9c1cd;
}
.row .act:hover { border-color: #78bfff; color: #ffffff; }
.row.pick { cursor: pointer; }
.row.pick:hover { background-color: rgba(120, 191, 255, 30); }
.none { display: block; padding: 6px; font-size: 8px; line-height: 11px; color: #7d8796; }

.step { position: absolute; left: 10px; top: 32px; width: 280px; font-size: 9px; line-height: 12px; color: #ffe08a; }
.picked { position: absolute; left: 10px; top: 48px; width: 280px; height: 30px; }
.picked .box { position: absolute; left: 0px; top: 0px; width: 28px; height: 28px; background-color: #09101b; border: 1px #3e4652; border-radius: 4px; }
.picked .label { position: absolute; left: 36px; top: 0px; width: 244px; font-size: 9px; line-height: 30px; color: #e9edf3; white-space: nowrap; overflow: hidden; }

#coins { position: absolute; left: 10px; top: 86px; width: 284px; height: 180px; }
.coin { float: left; position: relative; width: 66px; height: 54px; margin-right: 4px; margin-bottom: 4px; cursor: pointer; }
.coin .box { position: absolute; left: 17px; top: 0px; width: 32px; height: 32px; background-color: #09101b; border: 1px #3e4652; border-radius: 4px; }
.coin:hover .box { border-color: #78bfff; background-color: #10213a; }
.coin .label { position: absolute; left: 0px; top: 35px; width: 66px; text-align: center; font-size: 7px; line-height: 9px; color: #b9c1cd; }
.coin:hover .label { color: #ffffff; }

#price_row { position: absolute; left: 10px; top: 92px; width: 280px; height: 26px; }
#price_field { position: absolute; left: 0px; top: 2px; width: 150px; height: 22px; padding: 3px 6px; font-size: 11px; line-height: 14px; }
#price_coin { position: absolute; left: 158px; top: 1px; width: 24px; height: 24px; }
#price_coin_name { position: absolute; left: 186px; top: 0px; width: 94px; font-size: 9px; line-height: 26px; color: #ffe08a; white-space: nowrap; overflow: hidden; }
#price_help { position: absolute; left: 10px; top: 124px; width: 280px; font-size: 8px; line-height: 11px; color: #7d8796; }

.button {
	position: absolute;
	top: 274px;
	height: 18px;
	text-align: center;
	font-size: 9px;
	line-height: 18px;
	background-color: #1e2228;
	border: 1px #3e4652;
	cursor: pointer;
	color: #b9c1cd;
}
.button:hover { border-color: #78bfff; color: #ffffff; }
.button.main { color: #ffffff; border-color: #78bfff; background-color: #14243a; }
#sell_open { left: 10px; width: 86px; }
#site { left: 102px; width: 104px; }
#close { left: 212px; width: 78px; }
#back1, #back2, #back3 { left: 212px; width: 78px; }
#sell { left: 10px; width: 120px; }

#note { position: absolute; left: 10px; top: 298px; width: 280px; text-align: center; font-size: 8px; line-height: 11px; color: #78e678; }
#hint { position: absolute; left: 10px; top: 318px; width: 280px; text-align: center; font-size: 8px; line-height: 11px; color: #7d8796; }
