/* MuToDog (MU Estudo, rodada 11): Log de caça (log_caca.rml), no jeito do cliente Godot (log_caca.gd): painel de 150 de
   largura no canto de cima à direita (486, 34), a altura vem das linhas. Px da tela de referência 640 x 480 (.stage). */
body { pointer-events: none; }
#screen { pointer-events: none; }

#panel {
	position: absolute;
	left: 486dp;
	top: 34dp;
	width: 150dp;
	padding-bottom: 16dp;
	background-color: rgba(20, 20, 24, 240);
	pointer-events: auto;
	drag: drag;
	cursor: move;
	color: #e9edf3;
	border: 1dp #3e4652;
	box-sizing: border-box;
}
#title {
	display: block;
	height: 13dp;
	margin: 1dp 1dp 4dp 1dp;
	background-color: rgba(120, 191, 255, 41);
	text-align: center;
	font-size: 8dp;
	line-height: 13dp;
	color: #dae0ea;
}
.row { display: block; position: relative; height: 10dp; margin: 0dp 6dp; font-size: 8dp; line-height: 10dp; white-space: nowrap; }
.row.vao { height: 4dp; }
.row .label { color: #bec6d2; }
.row .value { position: absolute; right: 0dp; top: 0dp; color: #e9edf3; }
.row.titulo { border-top: 1dp rgba(62, 70, 82, 128); }
.row.titulo .label { font-weight: bold; color: #aad6ff; }
#reset {
	position: absolute;
	right: 4dp;
	bottom: 3dp;
	width: 40dp;
	height: 10dp;
	background-color: rgba(120, 191, 255, 46);
	text-align: center;
	font-size: 8dp;
	line-height: 10dp;
	color: #aad6ff;
	cursor: pointer;
}
#reset:hover { color: #ffffff; }
