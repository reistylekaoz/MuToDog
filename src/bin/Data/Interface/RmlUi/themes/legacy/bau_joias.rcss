/* MuToDog (MU Estudo, rodada 16): Baú de joias (bau_joias.rml), no jeito do cliente Godot (janela_bau_joias.gd): janela
   de 300 x 340 à esquerda da mochila (guardar é Ctrl + botão direito nela). Px da tela de referência 640 x 480
   (.stage). Os sprites das joias (item-<grupo>-<numero>) são escritos por tools/obsidiana_theme/icones_itens.py entre
   as marcas abaixo. */
/* sprites */
@spritesheet itens-bau
{
	src: "../modern/itens/todos.tga";
	item-12-15: 608px 480px 32px 32px;
	item-14-13: 704px 704px 32px 32px;
	item-14-14: 736px 704px 32px 32px;
	item-14-16: 800px 704px 32px 32px;
	item-14-22: 992px 704px 32px 32px;
	item-14-31: 224px 736px 32px 32px;
	item-14-41: 544px 736px 32px 32px;
	item-14-42: 576px 736px 32px 32px;
	item-14-43: 608px 736px 32px 32px;
	item-14-44: 640px 736px 32px 32px;
	item-14-151: 832px 832px 32px 32px;
	item-14-152: 864px 832px 32px 32px;
	item-14-153: 896px 832px 32px 32px;
	item-14-156: 992px 832px 32px 32px;
	item-14-157: 0px 864px 32px 32px;
	item-255-255: 256px 896px 32px 32px;
}
/* fim dos sprites */
body { pointer-events: none; }
#screen { pointer-events: none; }

#panel {
	position: absolute;
	left: 140px;
	top: 60px;
	width: 300px;
	height: 340px;
	background-color: rgba(8, 10, 14, 240);
	border: 1px #3e4652;
	pointer-events: auto;
	color: #e9edf3;
}
#title {
	position: absolute;
	left: 0px;
	top: 6px;
	width: 300px;
	height: 16px;
	text-align: center;
	font-size: 12px;
	line-height: 16px;
	color: #dae0ea;
}
#rule { position: absolute; left: 8px; top: 26px; width: 284px; height: 1px; background-color: #3e4652; }
#saldo, #retirar, #escolher, #separar { position: absolute; left: 0px; top: 0px; width: 300px; height: 340px; }

.art { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; }
#rows { position: absolute; left: 10px; top: 32px; width: 280px; height: 234px; border: 1px #262b33; }
#bag { position: absolute; left: 10px; top: 48px; width: 280px; height: 218px; border: 1px #262b33; }

.row { display: block; position: relative; height: 22px; border-bottom: 1px #161a20; }
.row .art { left: 2px; top: 1px; width: 20px; height: 20px; }
.row .name { position: absolute; left: 26px; top: 0px; width: 110px; font-size: 8px; line-height: 22px; color: #e9edf3; white-space: nowrap; overflow: hidden; }
.row .qty { position: absolute; left: 138px; top: 0px; width: 82px; text-align: right; font-size: 9px; line-height: 22px; color: #ffe08a; white-space: nowrap; overflow: hidden; }
.row .qty.zero { color: #5c6573; }
.row .act {
	position: absolute;
	left: 226px;
	top: 3px;
	width: 44px;
	height: 15px;
	text-align: center;
	font-size: 8px;
	line-height: 15px;
	background-color: #1e2228;
	border: 1px #3e4652;
	cursor: pointer;
	color: #b9c1cd;
}
.row .act:hover { border-color: #78bfff; color: #ffffff; }
.row .site { position: absolute; left: 222px; top: 0px; width: 52px; text-align: center; font-size: 7px; line-height: 22px; color: #7d8796; }
.row.pick { cursor: pointer; }
.row.pick:hover { background-color: rgba(120, 191, 255, 30); }
.none { display: block; padding: 6px; font-size: 8px; line-height: 11px; color: #7d8796; }

.step { position: absolute; left: 10px; top: 32px; width: 280px; font-size: 9px; line-height: 12px; color: #ffe08a; }
.picked { position: absolute; left: 10px; top: 48px; width: 280px; height: 30px; }
.picked .box { position: absolute; left: 0px; top: 0px; width: 28px; height: 28px; background-color: #09101b; border: 1px #3e4652; border-radius: 4px; }
.picked .label { position: absolute; left: 36px; top: 0px; width: 244px; font-size: 9px; line-height: 30px; color: #e9edf3; white-space: nowrap; overflow: hidden; }
#qty_field { position: absolute; left: 10px; top: 92px; width: 150px; height: 22px; padding: 3px 6px; font-size: 11px; line-height: 14px; }
.help { position: absolute; left: 10px; top: 124px; width: 280px; font-size: 8px; line-height: 11px; color: #7d8796; }

.button {
	position: absolute;
	top: 274px;
	height: 18px;
	text-align: center;
	font-size: 9px;
	line-height: 18px;
	background-color: #1e2228;
	border: 1px #3e4652;
	cursor: pointer;
	color: #b9c1cd;
}
.button:hover { border-color: #78bfff; color: #ffffff; }
.button.main { color: #ffffff; border-color: #78bfff; background-color: #14243a; }
#group { left: 10px; width: 86px; }
#split_open { left: 102px; width: 104px; }
#close { left: 212px; width: 78px; }
#back1, #back2, #back3 { left: 212px; width: 78px; }
#withdraw, #split { left: 10px; width: 120px; }

#note { position: absolute; left: 10px; top: 296px; width: 280px; text-align: center; font-size: 8px; line-height: 11px; color: #78e678; }
#hint { position: absolute; left: 10px; top: 312px; width: 280px; text-align: center; font-size: 8px; line-height: 11px; color: #7d8796; }
