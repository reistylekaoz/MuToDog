/* fim dos sprites */
@spritesheet colecoes-carrinho
{
	src: "../modern/colecoes/carrinho.tga";
	col-carrinho: 0dp 0dp 64dp 64dp;
}
body { pointer-events: none; }
#screen { pointer-events: none; }

#panel {
	position: absolute;
	left: 105dp;
	top: 54dp;
	width: 430dp;
	height: 372dp;
	background-color: rgba(8, 10, 14, 240);
	border: 1dp #3e4652;
	pointer-events: auto;
	color: #e9edf3;
}
#title {
	position: absolute;
	left: 0dp;
	top: 6dp;
	width: 430dp;
	height: 16dp;
	text-align: center;
	font-size: 12dp;
	line-height: 16dp;
	color: #dae0ea;
}
.tab {
	position: absolute;
	z-index: 2;
	top: 30dp;
	height: 18dp;
	text-align: center;
	font-size: 9dp;
	line-height: 18dp;
	background-color: #1e2228;
	border: 1dp #3e4652;
	cursor: pointer;
	color: #b9c1cd;
}
.tab:hover { color: #ffffff; }
.tab.selected { border-bottom: 2dp #78bfff; color: #ffffff; }
#tab_all { left: 10dp; width: 86dp; }
#tab_sets { left: 100dp; width: 60dp; }
#tab_add { left: 164dp; width: 100dp; }
#rule { position: absolute; left: 8dp; top: 53dp; width: 414dp; height: 1dp; background-color: #3e4652; }

.art { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; }
.piece { position: relative; background-color: #09101b; border: 1dp #3e4652; border-radius: 4dp; }
.piece .art { opacity: 0.32; }
.piece.dada { border-color: #78bfff; background-color: #10213a; }
.piece.dada .art, .piece.mochila .art { opacity: 1; }
.piece.mochila { border: 2dp #e8c96a; animation: 0.45s quadratic-in-out infinite alternate colecao-pisca; }
.piece.vazia { border-color: #262b33; }
@keyframes colecao-pisca {
	from { border-color: #6b5a2a; }
	to { border-color: #ffe08a; }
}
.check {
	position: absolute;
	right: 2dp;
	bottom: 1dp;
	width: 12dp;
	height: 12dp;
	border-radius: 6dp;
	background-color: #143c1e;
	text-align: center;
	font-size: 9dp;
	line-height: 12dp;
	color: #78e678;
}
.none { position: absolute; left: 0dp; top: 17dp; width: 100%; text-align: center; font-size: 7dp; color: #4a515c; }
.label {
	height: 14dp;
	text-align: center;
	font-size: 8dp;
	line-height: 14dp;
	background-color: #0e141f;
	border: 1dp #262b33;
	border-radius: 3dp;
	color: #b9c1cd;
	overflow: hidden;
	white-space: nowrap;
}

/* aba Todos os itens: a peça escolhida (com as setas) e a grade 5 x 3 que rola */
#all { position: absolute; left: 0dp; top: 0dp; width: 430dp; height: 372dp; }
.arrow {
	position: absolute;
	top: 60dp;
	width: 22dp;
	height: 34dp;
	text-align: center;
	font-size: 14dp;
	line-height: 34dp;
	color: #8791a0;
	cursor: pointer;
}
.arrow:hover { color: #ffffff; }
#arrow_prev { left: 88dp; }
#arrow_next { left: 322dp; }
#parts { position: absolute; left: 110dp; top: 60dp; width: 212dp; height: 36dp; }
.part {
	float: left;
	position: relative;
	width: 34dp;
	height: 34dp;
	margin-left: 3dp;
	margin-right: 3dp;
	background-color: #09101b;
	border: 1dp #3e4652;
	border-radius: 4dp;
	cursor: pointer;
}
.part .art { opacity: 0.6; }
.part:hover .art, .part.selected .art { opacity: 1; }
.part.selected { border-color: #78bfff; background-color: #10213a; }
#part_name { position: absolute; left: 345dp; top: 70dp; width: 76dp; font-size: 9dp; line-height: 14dp; color: #dae0ea; }
#grid { position: absolute; left: 18dp; top: 100dp; width: 392dp; height: 236dp; }
.cell { float: left; position: relative; width: 76dp; height: 84dp; cursor: pointer; }
.cell .label { position: absolute; left: 3dp; top: 2dp; width: 68dp; }
.cell .piece { position: absolute; left: 8dp; top: 19dp; width: 58dp; height: 58dp; }
.cell:hover .piece { border-color: #78bfff; }

/* aba Sets: a lista na esquerda, o set aberto e os bônus ligados na direita */
#sets { position: absolute; left: 0dp; top: 0dp; width: 430dp; height: 372dp; }
#cards { position: absolute; left: 8dp; top: 60dp; width: 110dp; height: 276dp; }
.card { display: block; position: relative; width: 98dp; height: 92dp; margin-bottom: 4dp; cursor: pointer; border: 1dp rgba(0, 0, 0, 0); border-radius: 4dp; }
.card.open { border-color: #78bfff; background-color: rgba(120, 191, 255, 26); }
.card .label { position: absolute; left: 3dp; top: 2dp; width: 90dp; }
.card.done .label, .card.open .label { color: #ffffff; }
.card .box { position: absolute; left: 16dp; top: 19dp; width: 64dp; height: 68dp; background-color: #09101b; border: 1dp #3e4652; border-radius: 4dp; }
.card .box .art { left: 4dp; top: 6dp; width: 56dp; height: 56dp; opacity: 0.7; }
.card.done .box .art, .card.open .box .art { opacity: 1; }
.card .count { position: absolute; left: 16dp; top: 74dp; width: 60dp; text-align: right; font-size: 8dp; color: #7d8796; }
.card.done .count { color: #78e678; }
#setbox {
	position: absolute;
	left: 124dp;
	top: 60dp;
	width: 296dp;
	height: 140dp;
	background-color: rgba(10, 15, 28, 235);
	border: 1dp #262b33;
	border-radius: 4dp;
}
#set_name { position: absolute; left: 0dp; top: 3dp; width: 296dp; text-align: center; font-size: 10dp; line-height: 14dp; color: #dae0ea; }
#slots { position: absolute; left: 13dp; top: 20dp; width: 270dp; height: 64dp; }
.slot { float: left; position: relative; width: 54dp; height: 64dp; border-width: 0; }
.slot .label { position: absolute; left: 3dp; top: 0dp; width: 46dp; height: 12dp; line-height: 12dp; }
.slot .piece { position: absolute; left: 4dp; top: 16dp; width: 44dp; height: 44dp; cursor: pointer; }
#set_text { position: absolute; left: 0dp; top: 88dp; width: 296dp; text-align: center; font-size: 9dp; line-height: 12dp; color: #b9c1cd; }
#set_text.done { color: #78e678; }
#set_bonus { position: absolute; left: 0dp; top: 102dp; width: 296dp; text-align: center; font-size: 10dp; line-height: 14dp; color: #ffe08a; }
#set_help { position: absolute; left: 0dp; top: 122dp; width: 296dp; text-align: center; font-size: 8dp; line-height: 10dp; color: #7d8796; }
#active {
	position: absolute;
	left: 270dp;
	top: 206dp;
	width: 150dp;
	height: 130dp;
	background-color: rgba(10, 15, 28, 235);
	border: 1dp #262b33;
	border-radius: 4dp;
}
#active_title { display: block; margin: 4dp 8dp 0dp 8dp; font-size: 10dp; line-height: 14dp; color: #dae0ea; }
#active_count { display: block; margin: 0dp 8dp 4dp 8dp; font-size: 8dp; line-height: 11dp; color: #ffe08a; }
.bonus { display: block; margin: 0dp 8dp; font-size: 9dp; line-height: 12dp; color: #78e678; }
#active_none { display: block; margin: 0dp 8dp; font-size: 8dp; line-height: 11dp; color: #7d8796; }

/* a caixinha + Adicionar item: uma casa, o item escolhido, a lista das peças de set da mochila */
#add_layer { z-index: 3; position: absolute; left: 0dp; top: 56dp; width: 430dp; height: 316dp; background-color: rgba(0, 0, 0, 140); }
#add_box {
	position: absolute;
	left: 95dp;
	top: 6dp;
	width: 240dp;
	height: 276dp;
	background-color: rgba(12, 19, 36, 252);
	border: 2dp #525a66;
	border-radius: 5dp;
}
#add_title { position: absolute; left: 0dp; top: 6dp; width: 240dp; text-align: center; font-size: 10dp; line-height: 14dp; color: #dae0ea; }
#add_slot { position: absolute; left: 90dp; top: 24dp; width: 60dp; height: 60dp; background-color: #09101b; border: 1dp #3e4652; border-radius: 4dp; }
#add_slot.filled { border-color: #ffe08a; }
#add_slot .art { left: 4dp; top: 4dp; width: 52dp; height: 52dp; }
#add_name { position: absolute; left: 6dp; top: 88dp; width: 228dp; text-align: center; font-size: 9dp; line-height: 12dp; color: #ffe08a; }
#add_msg { position: absolute; left: 6dp; top: 101dp; width: 228dp; text-align: center; font-size: 8dp; line-height: 11dp; color: #7d8796; }
#add_msg.ok { color: #78e678; }
#add_msg.falta { color: #ff6e5a; }
#bag_title { position: absolute; left: 10dp; top: 126dp; width: 220dp; font-size: 8dp; line-height: 10dp; color: #b9c1cd; }
#bag { position: absolute; left: 10dp; top: 138dp; width: 220dp; height: 82dp; border: 1dp #262b33; }
.bag { display: block; position: relative; height: 20dp; cursor: pointer; border-bottom: 1dp #161a20; }
.bag:hover { background-color: rgba(120, 191, 255, 20); }
.bag.selected { background-color: rgba(120, 191, 255, 46); }
.bag .art { left: 2dp; top: 1dp; width: 18dp; height: 18dp; }
.bag .name { position: absolute; left: 24dp; top: 0dp; width: 120dp; font-size: 8dp; line-height: 20dp; color: #e9edf3; white-space: nowrap; overflow: hidden; }
.bag .info { position: absolute; left: 146dp; top: 0dp; width: 64dp; text-align: right; font-size: 7dp; line-height: 20dp; color: #7d8796; }
.bag.ok .info { color: #78e678; }
.bag.falta .info { color: #ff6e5a; }
#bag_none { display: block; padding: 6dp; font-size: 8dp; color: #7d8796; }
#add_note { position: absolute; left: 6dp; top: 226dp; width: 228dp; text-align: center; font-size: 8dp; line-height: 10dp; color: #7d8796; }
#give, #add_close, #close {
	position: absolute;
	text-align: center;
	background-color: #1e2228;
	border: 1dp #3e4652;
	cursor: pointer;
	font-size: 9dp;
}
#give { left: 14dp; top: 246dp; width: 96dp; height: 18dp; line-height: 18dp; color: #ffffff; }
#add_close { left: 130dp; top: 246dp; width: 96dp; height: 18dp; line-height: 18dp; }
#give:hover, #add_close:hover, #close:hover { border-color: #78bfff; color: #ffffff; }
#give.disabled { color: #4a515c; cursor: default; }
#give.disabled:hover { border-color: #3e4652; }
#close { z-index: 2; left: 185dp; top: 344dp; width: 60dp; height: 18dp; line-height: 18dp; }

/* rodada 9: o carrinho no canto da peça que falta (compra com zen) */
.cart {
	position: absolute;
	z-index: 1;
	width: 16dp;
	height: 16dp;
	background-color: #50101a;
	border: 1dp #96603a;
	border-radius: 3dp;
	cursor: pointer;
	decorator: image(col-carrinho);
}
.cart:hover { background-color: #7a1a1a; border-color: #dcaa5a; }
.slot .cart { left: 34dp; top: 45dp; }
.cell .cart { left: 52dp; top: 62dp; }

/* a vitrine: o personagem vestindo o set aberto (render target do PhotoViewerControl) */
#photo_slot {
	position: absolute;
	left: 124dp;
	top: 206dp;
	width: 140dp;
	height: 130dp;
	decorator: linear-gradient(to bottom, #2a1d44 0%, #0b0914 100%);
	border: 1dp #3e3458;
	border-radius: 4dp;
	cursor: move;
	pointer-events: auto;
}
#photo_image { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; pointer-events: none; }
#vitrine_class { position: absolute; left: 6dp; bottom: 3dp; font-size: 8dp; line-height: 10dp; color: #b4a6d6; pointer-events: none; }
#vitrine_hint { position: absolute; right: 5dp; top: 3dp; font-size: 7dp; line-height: 9dp; color: #5e5478; pointer-events: none; }

/* a confirmação da compra */
#buy_layer { z-index: 3; position: absolute; left: 0dp; top: 56dp; width: 430dp; height: 316dp; background-color: rgba(0, 0, 0, 140); }
#buy_box {
	position: absolute;
	left: 85dp;
	top: 40dp;
	width: 260dp;
	height: 190dp;
	background-color: rgba(12, 19, 36, 252);
	border: 2dp #525a66;
	border-radius: 5dp;
}
#buy_title { position: absolute; left: 0dp; top: 6dp; width: 260dp; text-align: center; font-size: 10dp; line-height: 14dp; color: #dae0ea; }
#buy_slot { position: absolute; left: 100dp; top: 24dp; width: 60dp; height: 60dp; background-color: #09101b; border: 1dp #ffe08a; border-radius: 4dp; }
#buy_slot .art { left: 4dp; top: 4dp; width: 52dp; height: 52dp; }
#buy_name { position: absolute; left: 6dp; top: 88dp; width: 248dp; text-align: center; font-size: 9dp; line-height: 12dp; color: #78bfff; }
#buy_ask { position: absolute; left: 6dp; top: 104dp; width: 248dp; text-align: center; font-size: 9dp; line-height: 12dp; color: #ffe08a; }
#buy_have { position: absolute; left: 6dp; top: 118dp; width: 248dp; text-align: center; font-size: 8dp; line-height: 11dp; color: #7d8796; }
#buy_have.ok { color: #78e678; }
#buy_have.falta { color: #ff6e5a; }
#buy_note { position: absolute; left: 6dp; top: 134dp; width: 248dp; text-align: center; font-size: 8dp; line-height: 10dp; color: #7d8796; }
#buy_ok, #buy_cancel {
	position: absolute;
	top: 160dp;
	width: 96dp;
	height: 18dp;
	line-height: 18dp;
	text-align: center;
	background-color: #1e2228;
	border: 1dp #3e4652;
	cursor: pointer;
	font-size: 9dp;
}
#buy_ok { left: 26dp; color: #ffffff; }
#buy_cancel { left: 138dp; }
#buy_ok:hover, #buy_cancel:hover { border-color: #78bfff; color: #ffffff; }
#buy_ok.disabled { color: #4a515c; cursor: default; }
#buy_ok.disabled:hover { border-color: #3e4652; }
