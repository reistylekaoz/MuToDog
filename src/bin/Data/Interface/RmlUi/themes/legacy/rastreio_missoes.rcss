/* MuToDog (MU Estudo, rodada 13): rastreio das missões (rastreio_missoes.rml), no jeito do cliente Godot
   (rastreio_quests.gd): 128 de largura na borda direita (508, 118), 28 por missão. Px da tela de referência 640 x 480. */
body { pointer-events: none; }
#screen { pointer-events: none; }

#panel {
	position: absolute;
	left: 508px;
	top: 118px;
	width: 128px;
	pointer-events: auto;
	drag: drag;
	cursor: move;
	color: #ebedf1;
}
#title { display: block; height: 12px; text-align: right; padding-right: 4px; font-size: 8px; line-height: 12px; color: #a6aebb; font-effect: shadow(1px 1px #000000); }
.quest { display: block; height: 28px; }
.name {
	display: block;
	position: relative;
	height: 12px;
	padding-left: 6px;
	background-color: rgba(0, 0, 0, 140);
	font-size: 8px;
	line-height: 12px;
	color: #f0be5a;
	white-space: nowrap;
	overflow: hidden;
}
.name .tag { position: absolute; left: 0px; top: 0px; width: 3px; height: 12px; background-color: #f0be5a; }
.quest.ready .name { color: #78e196; }
.quest.ready .name .tag { background-color: #78e196; }
.bar { display: block; position: relative; height: 12px; margin-top: 1px; background-color: rgba(0, 0, 0, 115); font-size: 8px; line-height: 12px; }
.fill { position: absolute; left: 0px; top: 0px; height: 12px; background-color: rgba(240, 190, 90, 89); }
.label { position: absolute; left: 5px; top: 0px; color: #ebedf1; white-space: nowrap; }
.count { position: absolute; right: 4px; top: 0px; color: #ebedf1; }
