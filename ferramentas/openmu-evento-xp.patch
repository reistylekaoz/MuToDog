+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic;
+
+using System.IO;
+using System.Text.Json;
+
+/// <summary>
+/// Evento de XP com hora pra acabar, sem religar o servidor: lê taxa_xp.json
+/// (ao lado do executável) no formato {"taxa": 100, "ate": "2026-10-30T15:40:00-03:00"}.
+/// Multiplica a taxa do banco até "ate"; depois disso, ou sem arquivo, vale 1.
+/// </summary>
+public static class EventoXp
+{
+    private static readonly string Arquivo = Environment.GetEnvironmentVariable("OPENMU_TAXA_XP")
+        ?? Path.Combine(AppContext.BaseDirectory, "taxa_xp.json");
+
+    private static DateTime _lidoEm = DateTime.MinValue;
+    private static float _taxa = 1;
+    private static DateTimeOffset _ate = DateTimeOffset.MinValue;
+
+    /// <summary>
+    /// Gets o fator do evento agora (1 sem evento).
+    /// </summary>
+    public static float Fator
+    {
+        get
+        {
+            if (DateTime.UtcNow - _lidoEm > TimeSpan.FromSeconds(5))
+            {
+                Ler();
+            }
+
+            return DateTimeOffset.Now < _ate ? _taxa : 1;
+        }
+    }
+
+    private static void Ler()
+    {
+        _lidoEm = DateTime.UtcNow;
+        try
+        {
+            if (!File.Exists(Arquivo))
+            {
+                _ate = DateTimeOffset.MinValue;
+                return;
+            }
+
+            using var doc = JsonDocument.Parse(File.ReadAllText(Arquivo));
+            _taxa = doc.RootElement.GetProperty("taxa").GetSingle();
+            _ate = DateTimeOffset.Parse(doc.RootElement.GetProperty("ate").GetString()!);
+        }
+        catch
+        {
+            _ate = DateTimeOffset.MinValue;
+        }
+    }
+}
