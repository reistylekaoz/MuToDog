diff --git a/src/GameLogic/TimedEffectStore.cs b/src/GameLogic/TimedEffectStore.cs
new file mode 100644
index 0000000..c76025b
--- /dev/null
+++ b/src/GameLogic/TimedEffectStore.cs
@@ -0,0 +1,153 @@
+// <copyright file="TimedEffectStore.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic;
+
+using System.Text.Json;
+using MUnique.OpenMU.DataModel.Configuration;
+using MUnique.OpenMU.GameLogic.Attributes;
+
+/// <summary>
+/// Effects of seals, scrolls and the gold channel ticket which last for days (like the periodic items of the original).
+/// Their end time is kept in a json file next to the server, so they survive leaving the game, and they are
+/// applied again when the character enters the world.
+/// An effect definition with a <see cref="MagicEffectDefinition.SubType"/> from <see cref="MinimumSubType"/> to <see cref="MaximumSubType"/> is such an effect:
+/// its duration is multiplied by the durability of the consumed item (the days bought in the cash shop).
+/// </summary>
+public static class TimedEffectStore
+{
+    /// <summary>
+    /// The minimum sub type of an effect definition which is kept over logout.
+    /// </summary>
+    public const byte MinimumSubType = 100;
+
+    /// <summary>
+    /// The maximum sub type of an effect definition which is kept over logout (200 and up are used by other effects).
+    /// </summary>
+    public const byte MaximumSubType = 199;
+
+    private static readonly object FileLock = new();
+
+    private static string FilePath => Environment.GetEnvironmentVariable("MU_EFEITOS_TEMPO")
+        ?? System.IO.Path.Combine(AppContext.BaseDirectory, "efeitos_tempo.json");
+
+    /// <summary>
+    /// Determines whether the effect definition is kept over logout.
+    /// </summary>
+    /// <param name="definition">The definition.</param>
+    /// <returns><c>true</c>, if the effect lasts for days.</returns>
+    public static bool IsTimed(MagicEffectDefinition definition) => definition.SubType is >= MinimumSubType and <= MaximumSubType;
+
+    /// <summary>
+    /// Applies the effect to the player for the given duration and remembers its end.
+    /// An active effect of the same sub type is replaced.
+    /// </summary>
+    /// <param name="player">The player.</param>
+    /// <param name="definition">The effect definition.</param>
+    /// <param name="duration">The duration.</param>
+    /// <param name="save">If set to <c>true</c>, the end time is written to the file.</param>
+    /// <returns><c>true</c>, if the effect got applied.</returns>
+    public static async ValueTask<bool> ApplyAsync(Player player, MagicEffectDefinition definition, TimeSpan duration, bool save = true)
+    {
+        if (player.Attributes is not { } attributes || duration <= TimeSpan.Zero)
+        {
+            return false;
+        }
+
+        var boosts = definition.PowerUpDefinitions
+            .Where(def => def.Boost is not null && def.TargetAttribute is not null)
+            .Select(def => new MagicEffect.ElementWithTarget(attributes.CreateElement(def), def.TargetAttribute!))
+            .ToArray();
+        if (boosts.Length == 0)
+        {
+            return false;
+        }
+
+        if (player.MagicEffectList.TryGetActiveEffectOfSubType(definition.SubType) is { } existingEffect)
+        {
+            await existingEffect.DisposeAsync().ConfigureAwait(false);
+        }
+
+        await player.MagicEffectList.AddEffectAsync(new MagicEffect(duration, definition, boosts)).ConfigureAwait(false);
+        if (save && player.SelectedCharacter is { } character)
+        {
+            Change(entries =>
+            {
+                var key = character.Id.ToString();
+                if (!entries.TryGetValue(key, out var list))
+                {
+                    list = [];
+                    entries[key] = list;
+                }
+
+                list.RemoveAll(e => e.SubType == definition.SubType || e.Until <= DateTime.UtcNow);
+                list.Add(new Entry(definition.Number, definition.SubType, DateTime.UtcNow + duration));
+            });
+        }
+
+        return true;
+    }
+
+    /// <summary>
+    /// Applies the remembered effects of the selected character again, with their remaining time.
+    /// </summary>
+    /// <param name="player">The player who entered the world.</param>
+    /// <returns>The task.</returns>
+    public static async ValueTask RestoreAsync(Player player)
+    {
+        if (player.SelectedCharacter is not { } character)
+        {
+            return;
+        }
+
+        List<Entry>? active = null;
+        Change(entries =>
+        {
+            if (entries.TryGetValue(character.Id.ToString(), out var list))
+            {
+                list.RemoveAll(e => e.Until <= DateTime.UtcNow);
+                active = [.. list];
+            }
+        });
+
+        foreach (var entry in active ?? [])
+        {
+            var definition = player.GameContext.Configuration.MagicEffects.FirstOrDefault(d => d.Number == entry.Number && d.SubType == entry.SubType);
+            if (definition is not null)
+            {
+                await ApplyAsync(player, definition, entry.Until - DateTime.UtcNow, false).ConfigureAwait(false);
+            }
+        }
+    }
+
+    private static void Change(Action<Dictionary<string, List<Entry>>> change)
+    {
+        lock (FileLock)
+        {
+            Dictionary<string, List<Entry>> entries;
+            try
+            {
+                entries = System.IO.File.Exists(FilePath)
+                    ? JsonSerializer.Deserialize<Dictionary<string, List<Entry>>>(System.IO.File.ReadAllText(FilePath)) ?? []
+                    : [];
+            }
+            catch (JsonException)
+            {
+                entries = [];
+            }
+
+            change(entries);
+            foreach (var key in entries.Where(e => e.Value.Count == 0).Select(e => e.Key).ToList())
+            {
+                entries.Remove(key);
+            }
+
+            var temporary = FilePath + ".novo";
+            System.IO.File.WriteAllText(temporary, JsonSerializer.Serialize(entries));
+            System.IO.File.Move(temporary, FilePath, true);
+        }
+    }
+
+    private sealed record Entry(short Number, byte SubType, DateTime Until);
+}
