+// <copyright file="CastleSiegeOwnerLogoHandlerPlugIn.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameServer.MessageHandler.CastleSiege;
+
+using System.Runtime.InteropServices;
+using MUnique.OpenMU.GameLogic;
+using MUnique.OpenMU.GameServer.RemoteView;
+using MUnique.OpenMU.Network.Packets.ClientToServer;
+using MUnique.OpenMU.Network.Packets.ServerToClient;
+using MUnique.OpenMU.PlugIns;
+
+/// <summary>
+/// estudo (rodada 25): C1 B9 02, o cliente pede a marca da guilda dona do castelo ao entrar no Valley of Loren
+/// (GMBattleCastle Init) e pinta com ela as bandeiras do castelo (Object31/Flag.tga). Sem dono, nao responde.
+/// </summary>
+[PlugIn]
+[Guid("6B0E6C61-4C1B-4F8E-9E83-2D5A0C7B1F25")]
+[BelongsToGroup(CastleSiegeHuntZoneGroupHandlerPlugIn.GroupKey)]
+internal sealed class CastleSiegeOwnerLogoHandlerPlugIn : ISubPacketHandlerPlugIn
+{
+    /// <inheritdoc/>
+    public bool IsEncryptionExpected => false;
+
+    /// <inheritdoc/>
+    public byte Key => GuildLogoOfCastleOwnerRequest.SubCode;
+
+    /// <inheritdoc/>
+    public async ValueTask HandlePacketAsync(Player player, Memory<byte> packet)
+    {
+        if (CastleSiegeHandlerContext.Get(player) is not { SiegeData: { IsOccupied: true, OwnerGuildId: { } owner } }
+            || player.GameContext is not IGameServerContext server)
+        {
+            return;
+        }
+
+        var id = await server.GuildServer.GetGuildIdAsync(owner).ConfigureAwait(false);
+        if (id == 0 || await server.GuildServer.GetGuildAsync(id).ConfigureAwait(false) is not { } guild)
+        {
+            return;
+        }
+
+        var logo = new byte[32];
+        (guild.Logo ?? []).AsSpan(0, Math.Min(32, guild.Logo?.Length ?? 0)).CopyTo(logo);
+        var connection = (player as RemotePlayer)?.Connection;
+        await connection.SendCastleSiegeOwnerLogoAsync(logo).ConfigureAwait(false);
+    }
+}
